<view class="member-page member-shell" style="{{themeStyle}}"><view class="member-title">训练记录</view><view class="member-subtitle">每一次认真训练，都算数</view><view wx:if="{{!rows.length}}" class="member-card member-empty">还没有已完成的训练记录</view><view wx:for="{{rows}}" wx:key="historyId" class="member-card training-card" data-id="{{item.historyId}}" bindtap="detail"><view class="member-row member-spread"><view><view class="training-date">{{item.date}} · {{item.coach.displayName}}</view><view class="member-subtitle">{{item.category||item.typeName||'训练课程'}}</view></view><view class="member-pill member-tag-done">已完成</view></view><view class="training-actions">{{item.actionNames||'训练内容已记录'}}</view></view><member-nav active="profile"/></view>
