@import "../../styles/vendor/weui-2.6.26.wxss";
@import "../../styles/member.wxss";
.history-page{--history-blue:#526de8;--history-coral:#ee7654;--history-green:#20a979;padding-top:24rpx;background:linear-gradient(180deg,#eaf8f2 0,#fff8f1 420rpx,#f7f8f6 100%)}
.training-card{position:relative;display:flex;align-items:stretch;min-height:132rpx;margin-bottom:16rpx;overflow:hidden;border:1rpx solid rgba(23,34,28,.06);border-radius:24rpx;background:#fff;box-shadow:0 10rpx 24rpx rgba(23,34,28,.06)}.training-accent{width:10rpx;background:var(--history-green)}.tone-1 .training-accent{background:var(--history-blue)}.tone-2 .training-accent{background:var(--history-coral)}
.training-main{flex:1;min-width:0;padding:22rpx 18rpx}.training-top{display:flex;align-items:baseline;gap:12rpx}.training-date{color:#17221c;font-size:28rpx;line-height:36rpx;font-weight:800}.training-time{padding:4rpx 9rpx;border-radius:999rpx;background:#e9f8f2;color:var(--history-green);font-size:19rpx;font-weight:750}.tone-1 .training-time{background:#edf0ff;color:var(--history-blue)}.tone-2 .training-time{background:#fff0ea;color:var(--history-coral)}
.training-meta{margin-top:4rpx;color:#6f7e78;font-size:20rpx}.training-actions{margin-top:12rpx;color:#263d36;font-size:22rpx;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.training-summary{margin-top:8rpx;color:#7b685f;font-size:20rpx;line-height:1.45;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}.training-arrow{display:flex;align-items:center;padding:0 18rpx 0 6rpx;color:#99a6a1;font-size:34rpx}
.history-empty{margin-top:70rpx;padding:50rpx 28rpx;text-align:center;color:#71817a;font-size:23rpx}.history-empty-mark{display:flex;align-items:center;justify-content:center;width:76rpx;height:76rpx;margin:0 auto 18rpx;border-radius:26rpx;background:#e7f8f1;color:var(--history-green);font-size:30rpx;font-weight:850}
.history-month-head{display:flex;align-items:flex-end;justify-content:space-between;gap:20rpx;margin-bottom:18rpx}.history-month-kicker{color:var(--history-green);font-size:18rpx;font-weight:850;letter-spacing:2rpx}.history-month-title{margin-top:5rpx;color:#17221c;font-size:34rpx;font-weight:850}.history-month-picker{padding:12rpx 0;color:var(--history-blue);font-size:22rpx;font-weight:750}
.trend-card{overflow:hidden;border:1rpx solid rgba(82,109,232,.15);border-radius:28rpx;background:linear-gradient(150deg,#f4f6ff,#fff 58%,#effbf6);box-shadow:0 12rpx 30rpx rgba(39,59,108,.08)}.trend-scroll{width:100%;height:246rpx}.trend-canvas{position:relative;height:236rpx;margin:0 auto}.trend-grid{position:absolute;left:20rpx;right:20rpx;height:1rpx;background:rgba(82,109,232,.12)}.line-one{top:48rpx}.line-two{top:92rpx}.line-three{top:136rpx}.trend-line{position:absolute;height:5rpx;border-radius:999rpx;background:linear-gradient(90deg,var(--history-blue),var(--history-green));transform-origin:0 50%}.trend-point{position:absolute;z-index:2;width:20rpx;height:20rpx;border:6rpx solid #fff;border-radius:50%;background:var(--history-green);box-shadow:0 3rpx 12rpx rgba(32,169,121,.32)}.trend-point.active{width:24rpx;height:24rpx;margin:-2rpx 0 0 -2rpx;background:var(--history-coral);box-shadow:0 0 0 8rpx rgba(238,118,84,.14)}.trend-label{position:absolute;top:158rpx;width:94rpx;text-align:center}.trend-label text{display:block;color:#65736e;font-size:18rpx;line-height:1.4}.trend-label text:first-child{color:#31423c;font-weight:750}
.selected-training{display:flex;align-items:center;gap:18rpx;margin:0 18rpx 18rpx;padding:18rpx 20rpx;border-radius:20rpx;background:#fff}.selected-training>view:first-child{flex:1;min-width:0}.selected-training b,.selected-training text{display:block}.selected-training b{color:#17221c;font-size:25rpx}.selected-training text{margin-top:4rpx;color:#6e7b76;font-size:20rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.selected-open{flex:none;color:var(--history-blue);font-size:20rpx;font-weight:750}
.month-summary-card{display:flex;align-items:flex-start;gap:22rpx;margin-top:18rpx;padding:24rpx;border-radius:26rpx;background:linear-gradient(135deg,#173c38,#31556b);color:#fff}.summary-count{flex:none;width:92rpx;text-align:center}.summary-count b,.summary-count text{display:block}.summary-count b{font-size:52rpx;line-height:1}.summary-count text{margin-top:6rpx;color:rgba(255,255,255,.7);font-size:19rpx}.summary-copy{flex:1;min-width:0}.summary-copy view{font-size:21rpx;line-height:1.55;color:#9ee6bd}.summary-copy text{display:block;margin-top:10rpx;font-size:22rpx;line-height:1.65;color:#fff}

/* 2026-10-23 · 训练趋势页统一 Minimalist 卡片层级。 */
.history-page{--history-blue:#4c76df;--history-coral:#ef7654;--history-green:#22a77a;padding:28rpx;background:linear-gradient(180deg,#edf9f4 0,#fffaf3 520rpx,#fbfaf5 100%)}.history-month-head{padding:12rpx 4rpx 20rpx}.history-month-picker{padding:12rpx 18rpx;border-radius:999rpx;background:#eafaf4;color:#176e68}.month-summary-card{border:0;border-radius:30rpx;background:linear-gradient(135deg,#103f3b,#176e68);box-shadow:0 16rpx 36rpx rgba(16,63,59,.14)}.trend-card{border-color:#dce7fa;border-radius:30rpx;background:linear-gradient(145deg,#fff,#f1f6ff);box-shadow:0 10rpx 28rpx rgba(76,118,223,.07)}.trend-point{background:#4c76df}.trend-point.active{background:#ef7654;box-shadow:0 0 0 8rpx rgba(239,118,84,.14)}.selected-training{border:1rpx solid #f7d7cc;border-radius:24rpx;background:linear-gradient(145deg,#fff1ec,#fff)}.history-empty{border-radius:28rpx;background:#fff}
