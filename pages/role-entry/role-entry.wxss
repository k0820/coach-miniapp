@import "../../styles/member.wxss";
.role-page{padding-top:42rpx;background:#f4f5f6}
.role-hero{padding:22rpx 10rpx 42rpx}
.role-brand{display:flex;align-items:center;justify-content:center;gap:24rpx}
.role-brand-copy{text-align:left}
.role-kicker{font-size:22rpx;letter-spacing:5rpx;color:#7c858c;margin-bottom:5rpx}
.role-title{font-size:42rpx;line-height:1.2;color:#20272d}
.role-lead{text-align:center;margin-top:24rpx;color:#858d93}

.role-mark{width:112rpx;height:112rpx;border-radius:34rpx;background:#26333d;position:relative;box-shadow:0 14rpx 32rpx rgba(37,45,52,.16)}
.role-calendar-top{position:absolute;left:25rpx;top:22rpx;width:62rpx;height:12rpx;border-top:5rpx solid #fff;border-radius:3rpx}
.role-calendar-top view{position:absolute;top:-10rpx;width:7rpx;height:15rpx;border-radius:5rpx;background:#fff}
.role-calendar-top view:first-child{left:11rpx}.role-calendar-top view:last-child{right:11rpx}
.role-calendar-grid{position:absolute;left:27rpx;top:39rpx;width:58rpx;height:49rpx;display:grid;grid-template-columns:repeat(3,1fr);gap:5rpx}
.role-calendar-grid view{border-radius:2rpx;background:rgba(255,255,255,.86)}
.role-dumbbell{position:absolute;right:-5rpx;bottom:13rpx;display:flex;align-items:center;transform:rotate(-17deg)}
.role-bar{width:30rpx;height:5rpx;background:#c79a45}.role-weight{width:8rpx;height:18rpx;border-radius:4rpx;background:#c79a45}

.role-choice-panel{background:#fff;border:1rpx solid #e3e6e8;border-radius:34rpx;padding:0 26rpx;box-shadow:0 12rpx 32rpx rgba(37,45,52,.06)}
.role-card{display:flex;align-items:center;gap:24rpx;min-height:184rpx;padding:22rpx 4rpx}
.role-card-pressed{opacity:.7;background:#fafafa}
.role-divider{height:1rpx;background:#eceeef;margin-left:116rpx}
.role-icon{width:92rpx;height:92rpx;flex:0 0 92rpx;border-radius:28rpx;position:relative;display:flex;align-items:center;justify-content:center}
.role-icon.member{background:#f1eee7}.role-icon.coach{background:#e9edf0}
.role-person-head{position:absolute;top:19rpx;width:26rpx;height:26rpx;border-radius:50%;background:#6e6045}
.role-person-body{position:absolute;bottom:18rpx;width:50rpx;height:29rpx;border-radius:27rpx 27rpx 11rpx 11rpx;background:#6e6045}
.role-board{width:48rpx;height:58rpx;border:5rpx solid #3a4a55;border-radius:7rpx;box-sizing:border-box;padding:10rpx 7rpx}
.role-board view{height:4rpx;border-radius:4rpx;background:#3a4a55;margin-bottom:7rpx}
.role-copy{flex:1;min-width:0}
.role-label{display:inline-block;border-radius:999rpx;background:#f0f2f3;color:#69737a;font-size:19rpx;line-height:34rpx;padding:0 13rpx;margin-bottom:8rpx}
.role-name{font-size:32rpx;font-weight:850;color:#22282e;line-height:1.25;margin-bottom:5rpx}
.role-arrow{font-size:46rpx;color:#9ba2a7;padding:16rpx 4rpx}
.role-tip{display:flex;justify-content:center;align-items:center;gap:10rpx;font-size:22rpx;color:#8a9298;margin-top:34rpx}
.role-tip-dot{width:9rpx;height:9rpx;border-radius:50%;background:#a4adb2}
