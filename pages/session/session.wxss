.session{background:linear-gradient(180deg,#edf9f4 0,#fffaf3 520rpx,#fbfaf5 100%);color:#102a2b}.header{background:linear-gradient(135deg,#103f3b,#176e68)!important;color:#fff!important}.back{background:rgba(255,255,255,.13)!important}.body>.card,.reschedule-card,.pending-card,.done-card{border-color:#e3ebe7!important;border-radius:26rpx!important;background:#fff!important;box-shadow:0 10rpx 26rpx rgba(16,63,59,.05)!important}.reschedule-card{background:linear-gradient(145deg,#edf3ff,#fff)!important}.pending-card{background:linear-gradient(145deg,#fff8df,#fff)!important}.training-content-card{padding:15rpx 14rpx!important;border-radius:24rpx!important}.exercise-row{margin-bottom:8rpx;padding:7rpx 9rpx!important;border:1rpx solid #dce7fa!important;border-radius:16rpx!important;background:linear-gradient(145deg,#edf3ff,#fff)!important}.exercise-row:nth-child(3n+2){border-color:#d7eee5!important;background:linear-gradient(145deg,#eafaf4,#fff)!important}.exercise-row:nth-child(3n){border-color:#f7d7cc!important;background:linear-gradient(145deg,#fff1ec,#fff)!important}.metric-field{height:42rpx;border-color:#dfe8e5!important;background:#fff!important}.finish{background:#103f3b!important;box-shadow:none!important}.done-card{background:linear-gradient(145deg,#eafaf4,#fff)!important}.time-sheet,.cancel-sheet{background:#fbfaf5!important}.save-time{background:#103f3b!important}

