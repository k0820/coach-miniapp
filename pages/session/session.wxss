.cancel-mask{animation:cancelMaskIn .18s ease-out both}.cancel-sheet{animation:cancelSheetIn .3s cubic-bezier(.2,.8,.2,1) both}@keyframes cancelMaskIn{from{opacity:0}to{opacity:1}}@keyframes cancelSheetIn{from{transform:translateY(100%)}to{transform:translateY(0)}}
