<view wx:if="{{reschedule}}" class="time-mask" bindtap="closeReschedule" catchtouchmove="noop"><view class="time-sheet simple-time-sheet" catchtap="noop"><view class="time-sheet-head"><view><view class="sheet-title-left">修改课程时间</view><text>可以选择任意分钟</text></view><view class="time-big">{{editHour}}:{{editMinute<10?'0'+editMinute:editMinute}}</view></view><picker mode="date" value="{{editDate}}" bindchange="editDate"><view class="date-choice simple-choice"><text>上课日期</text><b>{{editDate}}</b><text>›</text></view></picker><picker mode="time" value="{{editHour}}:{{editMinute<10?'0'+editMinute:editMinute}}" start="06:00" end="23:00" bindchange="editTime"><view class="date-choice simple-choice"><text>上课时间</text><b>{{editHour}}:{{editMinute<10?'0'+editMinute:editMinute}}</b><text>›</text></view></picker><view class="minute-help">点击“上课时间”，滚动选择小时和00–59任意分钟</view><button class="save-time" bindtap="saveReschedule">保存新时间</button><view class="close-time" bindtap="closeReschedule">暂不修改</view></view></view>
<sandbox-banner/>
<view class="session">
  <view class="header"><view class="back" bindtap="back">‹</view><view class="head-info"><view>{{student.name}} {{completionSyncing?'· 完成同步中':(done?'· 已完成':'· 待完成')}}</view><text>{{booking.date}} {{booking.time}} · {{booking.typeName}} · ¥{{booking.price}}</text></view></view>
  <view class="body">
    <view class="reschedule-card" bindtap="{{legacyReadonly?'noop':'openReschedule'}}"><view><b>课程时间{{done?'（已完课）':''}}</b><text>{{booking.date}}　{{booking.time}}</text></view><view class="reschedule-action">{{legacyReadonly?'历史只读':'修改时间 ›'}}</view></view>
    <button wx:if="{{!done}}" class="reschedule-card calendar-entry" bindtap="addToCalendar">加入手机日历</button>
    <!-- M2「待确认」：超过「预计结束 + 3 小时」仍未下课。只提示，绝不替教练做判断 ——
         不自动扣课时、不自动判缺席、不自动产生收入。两个出口都由教练本人点。 -->
    <view wx:if="{{pendingConfirm && !done && !legacyReadonly}}" class="pending-card"><view class="pending-title">⚠️ 这节课还没有下课</view><text>已超过预计结束时间 {{pendingHours}} 小时，它仍占用着 1 节预约额度。请确认这节课到底有没有上。</text><view class="pending-actions"><button class="pending-done" disabled="{{completing}}" bindtap="complete">已上课 · 去完成</button><button class="pending-notheld" bindtap="markNotHeld">这节课没上</button></view></view>
    <block wx:if="{{(!done || editingCompleted) && !isStretch && !completing}}"><exercise-picker bindchoose="addExercise" /></block>
    <view class="card"><view class="title">✍️ 本节课内容</view><view class="hint">自动归类：{{category}}</view><view wx:if="{{pendingBooking}}" class="hint">预约正在自动同步，训练内容可以正常填写。</view><view wx:if="{{draftPending && !done}}" class="hint sync-hint">训练内容已保存，正在自动同步，无需操作。</view>
      <view wx:if="{{isStretch}}" class="stretch-duration"><view class="stretch-duration-head"><view><b>拉伸时长</b><text>记录本节拉伸恢复时间</text></view><strong>{{duration}} 分钟</strong></view><view wx:if="{{(!done || editingCompleted) && !completing}}" class="duration-options"><view wx:for="{{durationOptions}}" wx:key="*this" class="duration-option {{duration===item?'on':''}}" data-value="{{item}}" bindtap="setDuration">{{item}} 分钟</view></view></view>
      <view wx:if="{{!isStretch && !items.length}}" class="empty-small">还没有动作</view>
      <view wx:if="{{items.length}}" class="exercise-section exercise-list"><view wx:for="{{items}}" wx:for-item="exercise" wx:key="name" class="exercise-row {{dragIndex===index?'dragging':''}}" style="{{dragIndex===index?'transform:translate3d(0,'+dragOffset+'px,0);':dragIndex<dragTarget&&index>dragIndex&&index<=dragTarget?'transform:translate3d(0,-'+dragRowHeight+'px,0);':dragIndex>dragTarget&&index>=dragTarget&&index<dragIndex?'transform:translate3d(0,'+dragRowHeight+'px,0);':''}}"><view class="exercise-name"><b>{{exercise.name}}</b><text>{{exercise.group||'其他'}}</text></view><block wx:if="{{done && !editingCompleted}}"><view class="history-values" wx:if="{{isStretch || exercise.group==='拉伸'}}">{{exercise.minutes||15}} 分钟</view><view class="history-values" wx:else>{{exercise.sets||4}}组 × {{exercise.reps||12}}次<text wx:if="{{exercise.weight!=='' && exercise.weight!=null}}"> · {{exercise.weight}}kg</text></view></block><block wx:elif="{{isStretch || exercise.group==='拉伸'}}"><input disabled="{{completing}}" type="number" value="{{exercise.minutes||15}}" data-i="{{index}}" data-k="minutes" bindinput="itemInput"/><view>分钟</view></block><block wx:else><input disabled="{{completing}}" type="number" value="{{exercise.sets}}" data-i="{{index}}" data-k="sets" bindinput="itemInput"/><view>组</view><input disabled="{{completing}}" type="number" value="{{exercise.reps}}" data-i="{{index}}" data-k="reps" bindinput="itemInput"/><view>次</view><input disabled="{{completing}}" type="digit" value="{{exercise.weight}}" placeholder="kg" data-i="{{index}}" data-k="weight" bindinput="itemInput"/></block><view wx:if="{{(!done || editingCompleted) && !completing}}" class="drag-handle" data-i="{{index}}" catchtouchstart="dragStart" catchtouchmove="dragMove" catchtouchend="dragEnd" catchtouchcancel="dragCancel" aria-label="拖动调整动作顺序"><text></text><text></text><text></text></view><view wx:if="{{(!done || editingCompleted) && !completing}}" class="x" data-i="{{index}}" bindtap="remove">×</view></view></view>
      <view class="label">备注</view><view wx:if="{{done && !editingCompleted}}" class="notes history-notes">{{notes||'无备注'}}</view><textarea wx:else class="notes" disabled="{{completing}}" value="{{notes}}" placeholder="记录状态、注意事项…" bindinput="notes"/>
    </view>
    <button wx:if="{{!done}}" class="finish" disabled="{{completing}}" bindtap="complete">{{completing?'正在保存并完成课程…':'完成课程并保存训练记录（同时复制）'}}</button><view wx:else class="done-card">✓ 本节训练记录已保存<button bindtap="copySummary">复制训练内容发给学员</button></view><view wx:if="{{done && !legacyReadonly && !completionPending}}" class="completed-edit-actions"><button wx:if="{{!editingCompleted}}" bindtap="startEditCompleted">修改训练记录</button><block wx:else><button disabled="{{completing}}" bindtap="saveCompletedContent">{{completing?'正在保存…':'保存训练修改'}}</button><button disabled="{{completing}}" bindtap="cancelEditCompleted">取消修改</button></block></view>
    <!-- 开发期入口：只读诊断按钮与原始诊断 JSON 只在开发包显示（utils/release-flags.js）。
         用户侧保留「安全继续完成课程」这个恢复入口 —— 完课结果未知时它是用户唯一的自救手段，不属于开发工具。 -->
    <view wx:if="{{cloudPrimary && (devEntries || resumeAvailable)}}" class="card"><button wx:if="{{devEntries}}" bindtap="diagnoseCompletion">只读诊断本次完课</button><button wx:if="{{resumeAvailable}}" disabled="{{resumeBusy}}" class="finish" bindtap="resumeCompletion">{{resumeBusy?'正在确认结果':'安全继续完成课程'}}</button><text wx:if="{{devEntries && diagnostic}}" selectable="true" style="display:block;margin-top:16rpx;font-size:22rpx;white-space:pre-wrap;word-break:break-all;color:#64748b;">{{diagnosticText}}</text></view>
    <view wx:if="{{!legacyReadonly && !completionPending}}" class="bottom-cancel" style="margin-top:22rpx"><button class="cancel-btn" bindtap="showCancel">{{done?'删除本节记录':'取消预约'}}</button></view>
  </view>
</view>
<view wx:if="{{cancelSheet}}" class="cancel-mask" bindtap="hideCancel" catchtouchmove="noop"><view class="cancel-sheet" catchtap="noop"><view class="sheet-title">{{done?'删除本节记录':'取消课程'}}</view><block wx:if="{{done}}"><view class="sheet-option return" bindtap="deleteCompleted">删除本节记录及对应收入</view></block><block wx:else><view class="sheet-option" bindtap="cancelOnly">确认取消预约</view></block><view class="sheet-option back-option" bindtap="hideCancel">返回</view></view></view>
