/* ══════════════════════════════════════════════════════════════════════════════
   ⭐ 2026-10-02 · 本轮 UI 整理（正式落地；版式先在 layout-lab/pages/ui-lab 隔离验过）
   ⛔ 数值口径来自**隔离原型的实测几何**：
      · 名单一行 104rpx（52px）⇒ 常规屏一屏 8 个人（旧卡片 130px ⇒ 一屏 3 个）；
      · 课时包一张卡 ≈118rpx（61px）⇒ 一屏 ≥3 张（旧版一个包竖着 5 行 ≈190px ⇒ 一屏 1 个多）。
   ⛔ 只加样式：业务数据、判定逻辑、扣课/余额/销售口径一个字都没动。
   ══════════════════════════════════════════════════════════════════════════════ */

/* ── ① 名单：一人一行（姓名 + 关键状态 + 右箭头） ──────────────────────────── */
.students-list-page .student-row{margin-bottom:12rpx;padding:0 20rpx;height:104rpx;display:flex;align-items:center;gap:16rpx;background:var(--student-surface);border:1rpx solid var(--student-line);border-radius:20rpx;box-shadow:var(--student-shadow)}
.students-list-page .student-row:active{background:#f6f9ff}
.students-list-page .student-row-main{flex:1;min-width:0}
.students-list-page .student-row-name{font-size:28rpx;font-weight:800;color:var(--student-text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.students-list-page .student-row-meta{margin-top:3rpx;font-size:19rpx;color:var(--student-muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.students-list-page .student-row-state{flex:none;display:flex;align-items:center}
.students-list-page .student-row-left{font-size:23rpx;font-weight:800;color:var(--student-primary);font-variant-numeric:tabular-nums;white-space:nowrap}
.students-list-page .student-row-left.zero{color:var(--student-muted);font-weight:700}
.students-list-page .student-row-arrow{flex:none;font-size:32rpx;color:#b8c3d2;margin-left:2rpx}

/* ── ② 课时包：横向紧凑卡片（默认态；编辑态/新增态的表单一个字没改） ──────── */
.member-editor .pkg-card{display:flex;align-items:center;gap:12rpx;margin-top:10rpx;padding:13rpx 16rpx;background:#fff;border:1rpx solid var(--student-line);border-radius:15rpx;min-height:70rpx}
.member-editor .pkg-card:active{background:#f7faff}
.member-editor .pkg-card-main{flex:1;min-width:0}
.member-editor .pkg-card-name{font-size:24rpx;font-weight:800;color:var(--student-text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.member-editor .pkg-card-tag{display:inline-block;margin-left:8rpx;padding:1rpx 8rpx;border-radius:8rpx;background:#f3ecff;color:#7c3aed;font-size:17rpx;vertical-align:2rpx}
.member-editor .pkg-card-facts{display:flex;align-items:center;gap:8rpx;margin-top:4rpx;min-width:0}
