.booking-row{display:flex;align-items:center;justify-content:space-between;padding:14rpx 4rpx;border-top:1rpx solid #efe9e1}.booking-label{font-size:24rpx;color:#706e69}.booking-value{font-size:26rpx;font-weight:750;color:#26354a}

/* 2026-10-23 · 学员页统一样板风格，并按用户要求恢复一枚小型圆形新增入口。 */
.students-list-page{--student-primary:#176e68;--student-text:#102a2b;--student-muted:#71837f;--student-line:#e3ebe7;background:linear-gradient(180deg,#edf9f4 0,#fffaf3 460rpx,#fbfaf5 100%)}.students-page-head{margin:0 24rpx 14rpx;padding:24rpx;border-radius:30rpx;background:linear-gradient(135deg,#2f8278,#61b49e);box-shadow:0 14rpx 34rpx rgba(47,130,120,.16)}.students-page-head .title,.students-page-head .student-count b{color:#fff}.students-page-head .hint,.students-page-head .student-count-scope,.students-page-head .student-count text{color:rgba(255,255,255,.78)}.students-add{background:rgba(255,255,255,.2)!important;color:#fff!important;border:1rpx solid rgba(255,255,255,.3)!important}.renew-entry{margin:0 24rpx 14rpx;border:1rpx solid #f1dfaa;border-radius:22rpx;background:linear-gradient(145deg,#fff8df,#fff)}.letter-title{color:#176e68}.student-row{margin:0 24rpx 12rpx!important;border:1rpx solid #e3ebe7!important;border-radius:22rpx!important;background:#fff!important;box-shadow:0 8rpx 20rpx rgba(16,63,59,.04)!important}.student-row:nth-child(3n+1){background:linear-gradient(145deg,#fff,#edf3ff)!important}.student-row:nth-child(3n+2){background:linear-gradient(145deg,#fff,#eafaf4)!important}.student-row:nth-child(3n){background:linear-gradient(145deg,#fff,#fff1ec)!important}.member-editor{background:#fbfaf5}.member-editor .editor-head{border-radius:28rpx;background:linear-gradient(135deg,#103f3b,#176e68);padding:22rpx}.member-editor .editor-head .title,.member-editor .editor-head .hint{color:#fff}.member-editor .editor-section{margin-top:14rpx;padding:22rpx;border:1rpx solid #e3ebe7;border-radius:24rpx;background:#fff}.member-editor .qr-entry{background:linear-gradient(145deg,#edf3ff,#fff)}.member-editor .packages-section{background:linear-gradient(145deg,#eafaf4,#fff)}.member-editor .pkg-card{border-radius:18rpx}.member-editor-action{border-top-color:#e3ebe7}.students-scroll-tail{height:150rpx}.students-fab{position:fixed;right:42rpx;bottom:132rpx;z-index:18;width:88rpx;height:88rpx;display:flex;align-items:center;justify-content:center;border:6rpx solid rgba(255,255,255,.9);border-radius:50%;background:linear-gradient(145deg,#22a77a,#103f3b);color:#fff;font-size:48rpx;font-weight:500;line-height:1;box-shadow:0 14rpx 34rpx rgba(16,63,59,.28);transition:transform .14s ease,opacity .14s ease}.students-fab:active{transform:scale(.94);opacity:.84}

/* 2026-10-23 · 真机视觉收尾：名单页头与下方薄荷、浅蓝、浅橙卡片统一。 */
.students-list-page .students-page-head{background:linear-gradient(135deg,#dff5ed 0%,#dceafb 100%);border:1rpx solid #d2e8e1;box-shadow:0 10rpx 26rpx rgba(35,91,96,.08)}
.students-list-page .students-page-head .title,.students-list-page .students-page-head .student-count b{color:#14385a}
.students-list-page .students-page-head .hint,.students-list-page .students-page-head .student-count-scope,.students-list-page .students-page-head .student-count text{color:#6b7f88}
.students-list-page .students-add{background:rgba(255,255,255,.72)!important;color:#176e68!important;border-color:#c6e5db!important}
