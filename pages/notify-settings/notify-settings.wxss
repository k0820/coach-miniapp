/* 🔔 统一通知设置页（2026-10-06）· 只依赖全局 CSS 变量，不写死色值 */
.notify-page{padding:32rpx 28rpx 60rpx;background:var(--member-bg,#f3f6fb);min-height:100vh}
.notify-title{font-size:42rpx;font-weight:800;color:var(--navy,#132b4f)}
.notify-subtitle{margin-top:8rpx;font-size:25rpx;color:var(--muted,#8b8985)}
.notify-card{margin-top:24rpx;padding:26rpx 24rpx;border-radius:22rpx;background:#fff;border:2rpx solid var(--line,#e6e2d8)}
.notify-section-title{font-size:29rpx;font-weight:700;color:var(--navy,#132b4f);margin-bottom:12rpx}
.notify-line{font-size:26rpx;line-height:1.7;color:var(--navy,#132b4f)}
.notify-line.muted{color:var(--muted,#8b8985)}
.notify-template{padding:14rpx 0;border-top:2rpx dashed var(--line,#e6e2d8)}
.notify-template:first-child{border-top:0}
.notify-template-name{font-size:27rpx;font-weight:700;color:var(--navy,#132b4f)}
.notify-template-state{margin-top:6rpx;font-size:24rpx;color:var(--muted,#8b8985)}
.notify-empty{color:#bf5037;font-size:26rpx;line-height:1.7}
.notify-hint{margin-top:18rpx;font-size:25rpx;line-height:1.7;color:var(--muted,#8b8985)}
