page{background:#F7F7F2;color:#172B3A;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif}.wrap{min-height:100vh;box-sizing:border-box;padding:72rpx 36rpx calc(56rpx + env(safe-area-inset-bottom));background:linear-gradient(165deg,#DDF3F1 0,#F7F7F2 42%,#F7F7F2 100%)}.brand{text-align:left;color:#2DACB5;font-size:22rpx;line-height:1.5;font-weight:700;letter-spacing:2rpx}.title{margin-top:10rpx;text-align:left;color:#172B3A;font-size:44rpx;line-height:1.25;letter-spacing:-1rpx;font-weight:760}.subtitle{margin-top:10rpx;text-align:left;color:#70817F;font-size:24rpx;line-height:1.6}.card{margin-top:38rpx;padding:36rpx;background:#fff;border:0;border-radius:42rpx;box-shadow:0 20rpx 56rpx rgba(23,59,87,.09)}.center{text-align:center}.muted{color:#70817F}.error{color:#B84B43;line-height:1.7}.profile{text-align:center}.avatar{display:flex;align-items:center;justify-content:center;margin:0 auto;width:112rpx;height:112rpx;border-radius:36rpx;background:linear-gradient(145deg,#E4F5F3,#fff);color:#173B57;font-size:44rpx;font-weight:760;box-shadow:inset 0 0 0 1rpx rgba(45,172,181,.13)}.name{margin-top:22rpx;color:#172B3A;font-size:36rpx;line-height:1.3;font-weight:760}.code{margin-top:8rpx;color:#70817F;font-size:22rpx;line-height:1.5}.stats{display:flex;margin-top:30rpx;padding:26rpx 0;border-top:1rpx solid #E4ECE8;border-bottom:1rpx solid #E4ECE8}.stats view{flex:1}.stats b,.stats text{display:block}.stats b{color:#173B57;font-size:38rpx;font-weight:760}.stats text{margin-top:5rpx;color:#70817F;font-size:20rpx}.warning{margin-top:24rpx;padding:20rpx;border-radius:20rpx;background:#F8E9E6;color:#B84B43;font-size:23rpx;line-height:1.65}.notice{margin-top:24rpx;padding:20rpx;border-radius:20rpx;background:#F7F0DD;color:#8B672D;font-size:22rpx;line-height:1.7;text-align:left}.primary{margin-top:28rpx;height:92rpx;line-height:92rpx;border-radius:24rpx;background:#173B57;color:#fff;font-size:28rpx;font-weight:720;box-shadow:0 14rpx 28rpx rgba(23,59,87,.16);transition:transform .14s ease,opacity .14s ease}.primary:active{transform:scale(.985);opacity:.88}.primary::after{border:0}.privacy{margin-top:28rpx;padding:24rpx 26rpx;border-radius:24rpx;background:rgba(228,245,243,.82);color:#246B70;font-size:22rpx;line-height:1.75}

.primary{display:flex;align-items:center;justify-content:center;box-sizing:border-box;padding:0;line-height:1.2;text-align:center}
