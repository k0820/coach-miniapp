@import "../../styles/member.wxss";
page{background:#f5f7f5}.qr-page{min-height:100vh;box-sizing:border-box;padding:36rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));color:var(--member-text)}
.qr-head{padding:8rpx 4rpx 24rpx}.qr-kicker{font-size:21rpx;font-weight:800;letter-spacing:2rpx;color:var(--member-accent)}.title{margin-top:8rpx;font-size:38rpx;font-weight:820;line-height:1.25;color:var(--member-text)}.hint{margin-top:6rpx;font-size:22rpx;line-height:1.55;color:var(--member-text-sub)}
.card,.qr-panel,.status-section{background:#fff;border:1rpx solid var(--member-border)}.card{padding:24rpx;border-radius:24rpx}.center{text-align:center}.error{color:var(--member-danger)}
.qr-panel{padding:28rpx;border-radius:28rpx;text-align:center}.qr-frame{width:428rpx;height:428rpx;max-width:100%;margin:0 auto;padding:14rpx;box-sizing:border-box;border:1rpx solid var(--member-border);border-radius:24rpx;background:#fff}.qr{width:100%;height:100%}
.qr-actions{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin-top:24rpx}.qr-action{margin:0;height:78rpx;line-height:78rpx;border-radius:20rpx;font-size:25rpx;font-weight:760;padding:0}.qr-action::after{border:0}.qr-action.primary{background:var(--member-primary);color:#fff}.qr-action.ghost{background:var(--member-surface-alt);color:var(--member-primary);border:1rpx solid var(--member-border-strong)}
.rotate-link{display:inline-block;margin-top:18rpx;padding:10rpx;color:var(--member-danger);font-size:21rpx}.status-section{margin-top:20rpx;padding:0 24rpx;border-radius:24rpx}.binding-row{min-height:94rpx;display:flex;align-items:center;gap:16rpx}.status-mark{flex:none;width:16rpx;height:16rpx;border-radius:50%;background:var(--member-warning)}.status-mark.is-bound{background:var(--member-success)}.binding-copy{flex:1;min-width:0}.binding-title{font-size:25rpx;font-weight:780;color:var(--member-text)}.unbind-action{flex:none;padding:12rpx 0 12rpx 16rpx;color:var(--member-danger);font-size:21rpx;font-weight:720}.safe-note{padding:20rpx 0 22rpx;border-top:1rpx solid var(--member-border);color:var(--member-text-sub);font-size:21rpx;line-height:1.65}
.rotate-copy{padding:16rpx 0 30rpx;color:var(--member-text-sub);font-size:24rpx;line-height:1.7}

/* 2026-10-23 · 二维码页统一深绿主卡与四色状态。 */
page{background:#fbfaf5}.qr-page{--member-primary:#103f3b;--member-primary-deep:#0b302d;--member-accent:#22a77a;--member-soft:#eafaf4;--member-page-bg:#fbfaf5;--member-surface-alt:#f3f7f5;--member-border:#e3ebe7;--member-border-strong:#c6ded5;--member-text:#102a2b;--member-text-sub:#71837f;background:linear-gradient(180deg,#edf9f4 0,#fffaf3 500rpx,#fbfaf5 100%)}.qr-head{padding:26rpx 26rpx 28rpx;border-radius:32rpx;background:linear-gradient(135deg,#103f3b,#176e68)}.qr-head .qr-kicker{color:#a7e8d4}.qr-head .title{color:#fff}.qr-head .hint{color:rgba(255,255,255,.68)}.qr-panel{margin-top:20rpx;border-color:#d7eee5;border-radius:30rpx;background:linear-gradient(145deg,#eafaf4,#fff);box-shadow:0 12rpx 30rpx rgba(16,63,59,.06)}.qr-frame{border-color:#d7eee5;border-radius:28rpx}.qr-action.primary{background:#103f3b}.qr-action.ghost{background:#edf3ff;color:#4c76df;border-color:#dce7fa}.status-section{border-color:#f1dfaa;border-radius:26rpx;background:linear-gradient(145deg,#fff8df,#fff)}
