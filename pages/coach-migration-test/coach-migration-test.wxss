.meta-label{margin-top:24rpx;color:var(--muted);font-size:23rpx}
.meta-value{margin-top:10rpx;padding:18rpx;border:1rpx solid var(--line);border-radius:18rpx;background:var(--soft);font-size:23rpx;word-break:break-all}
.status{margin-top:16rpx;color:var(--accent);font-size:24rpx;font-weight:650;line-height:1.5}
.summary-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 24rpx;margin-top:18rpx}
.summary-grid view,.result-row{display:flex;justify-content:space-between;padding:18rpx 0;border-bottom:1rpx solid var(--line);color:var(--muted);font-size:25rpx}
.summary-grid text,.result-row b{color:var(--text);font-weight:750}
.result-id{margin-top:14rpx;color:var(--muted);font-size:20rpx;line-height:1.5;word-break:break-all}
