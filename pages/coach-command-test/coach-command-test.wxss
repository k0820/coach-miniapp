.page{min-height:100vh;padding:28rpx;background:#f3f6fb;box-sizing:border-box}.card{background:#fff;border-radius:24rpx;padding:28rpx;margin-bottom:24rpx;box-shadow:0 8rpx 24rpx rgba(19,43,79,.06)}.title{font-size:36rpx;font-weight:700;color:#132b4f}.hint{font-size:26rpx;color:#7b8798;line-height:1.6;margin:12rpx 0 24rpx}.card button{margin-top:18rpx;border-radius:18rpx;font-size:28rpx}.primary{background:#2563eb!important;color:#fff!important}.danger{color:#c7563d!important;background:#fff!important}.label{font-size:26rpx;font-weight:600;color:#132b4f;margin:12rpx 0}.result{display:block;white-space:pre-wrap;word-break:break-all;font-family:monospace;font-size:23rpx;line-height:1.55;color:#48566a}
