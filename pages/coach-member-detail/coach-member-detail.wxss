.wrap { padding: 28rpx; }
.title { font-size: 34rpx; font-weight: 850; color: var(--member-text, #1d2939); }
.hint { margin-top: 8rpx; font-size: 24rpx; line-height: 1.6; color: var(--member-muted, #7b8798); }
.hint.strong { color: #b27b28; font-weight: 700; }
.card { margin-top: 24rpx; padding: 26rpx; background: var(--member-surface, #fff); border: 1rpx solid var(--member-border, #e6ecf3); border-radius: 24rpx; }
.big-title { font-size: 28rpx; font-weight: 800; color: var(--member-text, #1d2939); }
.row { display: flex; }
.stat { flex: 1; text-align: center; }
.num { font-size: 48rpx; font-weight: 850; color: var(--member-primary, #3a454e); }
.num.alt { color: #b27b28; }
.num.weak { color: var(--member-muted, #7b8798); }
.label { margin-top: 4rpx; font-size: 22rpx; color: var(--member-muted, #7b8798); }
.hist-row { padding: 14rpx 0; border-bottom: 1rpx solid var(--member-border, #e6ecf3); font-size: 26rpx; }
.input { margin-top: 16rpx; height: 88rpx; padding: 0 20rpx; font-size: 28rpx; background: var(--member-page, #f4f7fb); border: 2rpx solid var(--member-border, #e6ecf3); border-radius: 18rpx; }
.btn { margin-top: 16rpx; height: 88rpx; line-height: 88rpx; text-align: center; font-size: 28rpx; font-weight: 800; border-radius: 20rpx; }
.btn.primary { background: var(--member-primary, #3a454e); color: #fff; }
.btn.ghost { background: var(--member-page, #f4f7fb); color: var(--member-text, #1d2939); }
.sheet { position: fixed; left: 0; right: 0; bottom: 0; z-index: 40; background: var(--member-surface, #fff); padding: 0 28rpx calc(24rpx + env(safe-area-inset-bottom)); box-shadow: 0 -10rpx 40rpx rgba(15,30,50,.18); }

/* 2026-10-23 · 教练端会员资料页统一 Minimalist 层级。 */
page{background:#fbfaf5}.wrap{min-height:100vh;box-sizing:border-box;padding:32rpx 28rpx 60rpx;background:linear-gradient(180deg,#edf9f4 0,#fffaf3 500rpx,#fbfaf5 100%)}.wrap>.title{padding:28rpx 26rpx 4rpx;border-radius:30rpx 30rpx 0 0;background:linear-gradient(135deg,#103f3b,#176e68);color:#fff}.wrap>.hint{margin:0;padding:4rpx 26rpx 26rpx;border-radius:0 0 30rpx 30rpx;background:linear-gradient(135deg,#103f3b,#176e68);color:rgba(255,255,255,.68)}.card{border-color:#e3ebe7;border-radius:26rpx;background:#fff;box-shadow:0 10rpx 26rpx rgba(16,63,59,.05)}.stat:first-child{padding:20rpx 8rpx;border-radius:22rpx;background:#eafaf4}.stat:nth-child(2){padding:20rpx 8rpx;border-radius:22rpx;background:#edf3ff}.stat:nth-child(3){padding:20rpx 8rpx;border-radius:22rpx;background:#fff1ec}.num{color:#176e68}.num.alt{color:#4c76df}.num.weak{color:#ef7654}.hist-row{border-color:#e3ebe7}.btn.primary{background:#103f3b}.btn.ghost{background:#edf3ff;color:#4c76df}.sheet{background:#fbfaf5;border-radius:34rpx 34rpx 0 0}
