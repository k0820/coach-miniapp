.wrap { padding: 28rpx; }
.title { font-size: 34rpx; font-weight: 850; color: var(--member-text, #1d2939); }
.hint { margin-top: 8rpx; font-size: 24rpx; line-height: 1.6; color: var(--member-muted, #7b8798); }
.hint.dim { opacity: .75; }
.card { margin-top: 24rpx; padding: 26rpx; background: var(--member-surface, #fff); border: 1rpx solid var(--member-border, #e6ecf3); border-radius: 24rpx; }
.big-title { font-size: 28rpx; font-weight: 800; color: var(--member-text, #1d2939); }
.qr-card { text-align: center; }
.qr-frame { margin: 0 auto; width: 430rpx; height: 430rpx; border-radius: 28rpx; background: var(--member-page, #f4f7fb); display: flex; align-items: center; justify-content: center; }
.qr-image { width: 430rpx; height: 430rpx; border-radius: 28rpx; }
.qr-empty { color: var(--member-muted, #7b8798); font-size: 24rpx; }
.qr-note { margin-top: 14rpx; color: #b27b28; font-size: 23rpx; }
.qr-actions { display: flex; gap: 16rpx; justify-content: center; margin-top: 20rpx; }
.input { margin-top: 16rpx; height: 88rpx; padding: 0 20rpx; font-size: 28rpx; background: var(--member-page, #f4f7fb); border: 2rpx solid var(--member-border, #e6ecf3); border-radius: 18rpx; }
.btn { margin-top: 16rpx; height: 88rpx; line-height: 88rpx; text-align: center; font-size: 28rpx; font-weight: 800; border-radius: 20rpx; }
.btn.primary { background: var(--member-primary, #3a454e); color: #fff; }
.btn.ghost { background: var(--member-page, #f4f7fb); color: var(--member-text, #1d2939); }
.qr-actions .btn { flex: 1; }
