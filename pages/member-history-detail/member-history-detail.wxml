<view class="member-page member-shell" style="{{themeStyle}}"><view wx:if="{{row}}"><view class="member-card detail-head"><view class="member-title">{{row.date}}</view><view class="member-subtitle">{{row.coach.displayName}} · {{row.category||row.typeName||'训练课程'}}</view><view wx:if="{{row.duration}}" class="member-pill">{{row.duration}} 分钟</view></view><view class="member-section-title">本节训练</view><view class="member-card"><view wx:for="{{row.items}}" wx:key="index" class="exercise"><view class="exercise-name">{{item.name}}</view><view class="member-subtitle"><block wx:if="{{item.minutes}}">{{item.minutes}} 分钟</block><block wx:else>{{item.sets||'-'}} 组 × {{item.reps||'-'}} 次<text wx:if="{{item.weight!==''}}"> · {{item.weight}}kg</text></block></view></view><view wx:if="{{!row.items.length}}" class="member-empty">没有公开的动作明细</view></view><view wx:if="{{row.memberSummary}}" class="member-card"><view class="member-section-title" style="margin:0 0 14rpx">教练给我的总结</view><view class="summary">{{row.memberSummary}}</view></view></view></view>
