<view class="member-page member-shell detail-page weui-page" data-weui-theme="light" style="{{themeStyle}}"><view wx:if="{{row}}"><view class="detail-hero"><view class="detail-kicker">训练完成</view><view class="detail-date">{{row.dateLabel}} {{row.timeLabel}}</view><view class="detail-meta">{{row.coachName}} · {{row.typeLabel}}<text wx:if="{{row.duration}}"> · {{row.duration}} 分钟</text></view></view><view class="exercise-list-card"><view wx:for="{{row.items}}" wx:key="index" class="exercise tone-{{index % 3}}"><view class="exercise-index">{{index+1}}</view><view class="exercise-copy"><view class="exercise-name">{{item.name}}</view><view class="exercise-value"><block wx:if="{{item.minutes}}">{{item.minutes}} 分钟</block><block wx:else>{{item.sets||'-'}} 组 × {{item.reps||'-'}} 次<text wx:if="{{item.weight!==''}}"> · {{item.weight}}kg</text></block></view></view></view><view wx:if="{{!row.items.length}}" class="member-empty">本节课没有公开的动作明细</view></view><view wx:if="{{row.memberSummary}}" class="summary-card"><view class="summary-label">教练总结</view><view class="summary">{{row.memberSummary}}</view></view></view></view>
