@import "../../styles/vendor/weui-2.6.26.wxss";
@import "../../styles/member.wxss";
.detail-page{--detail-green:#24b27f;--detail-blue:#526de8;--detail-coral:#ef7652;padding-top:24rpx;background:linear-gradient(180deg,#e9f8f1 0,#fff8f1 430rpx,#f7f8f6 100%)}.detail-hero{padding:30rpx 28rpx;border-radius:30rpx;background:linear-gradient(135deg,#17221c,#244b47 62%,#35566a);box-shadow:0 16rpx 38rpx rgba(23,34,28,.16);color:#fff}.detail-kicker{color:#ffc85a;font-size:20rpx;font-weight:750}.detail-date{margin-top:7rpx;font-size:36rpx;line-height:46rpx;font-weight:850}.detail-meta{margin-top:8rpx;color:rgba(255,255,255,.7);font-size:21rpx}
.exercise-list-card{margin-top:18rpx;overflow:hidden;border:1rpx solid #e3eae7;border-radius:24rpx;background:#fff}.exercise{display:flex;align-items:center;gap:14rpx;min-height:82rpx;padding:12rpx 18rpx;border-bottom:1rpx solid #edf1ef}.exercise:last-child{border-bottom:0}.exercise-index{display:flex;align-items:center;justify-content:center;width:42rpx;height:42rpx;border-radius:14rpx;background:#e8f8f2;color:var(--detail-green);font-size:20rpx;font-weight:850}.exercise.tone-1 .exercise-index{background:#edf0ff;color:var(--detail-blue)}.exercise.tone-2 .exercise-index{background:#fff0ea;color:var(--detail-coral)}.exercise-copy{flex:1;min-width:0}.exercise-name{color:#1c302b;font-size:25rpx;font-weight:780}.exercise-value{margin-top:2rpx;color:#76847f;font-size:20rpx}.summary-card{margin-top:18rpx;padding:22rpx 24rpx;border-radius:24rpx;background:linear-gradient(135deg,#fff0e9,#fffaf5);border:1rpx solid #ffd9ca}.summary-label{color:var(--detail-coral);font-size:20rpx;font-weight:800}.summary{margin-top:8rpx;color:#64483e;font-size:23rpx;line-height:1.65}.member-empty{padding:44rpx 24rpx}

/* 2026-10-23 · 单节训练详情：深绿摘要 + 三色紧凑动作卡。 */
.detail-page{padding:28rpx;background:linear-gradient(180deg,#edf9f4 0,#fffaf3 520rpx,#fbfaf5 100%)}.detail-hero{border-radius:32rpx;background:linear-gradient(135deg,#103f3b,#176e68);box-shadow:0 16rpx 36rpx rgba(16,63,59,.14)}.summary-card{border-color:#d7eee5;border-radius:26rpx;background:linear-gradient(145deg,#eafaf4,#fff)}.exercise-list-card{border:0;background:transparent}.exercise{margin-bottom:14rpx;padding:18rpx;border:1rpx solid #dce7fa;border-radius:22rpx;background:linear-gradient(145deg,#edf3ff,#fff)}.exercise:last-child{border-bottom:1rpx solid #dce7fa}.exercise.tone-1{border-color:#d7eee5;background:linear-gradient(145deg,#eafaf4,#fff)}.exercise.tone-2{border-color:#f7d7cc;background:linear-gradient(145deg,#fff1ec,#fff)}
