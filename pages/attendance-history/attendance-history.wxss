.attendance-page{padding:24rpx;background:#f3f6fb;min-height:100vh;box-sizing:border-box}.hero{padding:20rpx 8rpx 26rpx}.eyebrow{font-size:19rpx;font-weight:900;letter-spacing:3rpx;color:#2563eb}.hero-title{font-size:42rpx;font-weight:900;color:#132b4f;margin-top:5rpx}.hero-hint{font-size:21rpx;color:#7b8ba1;margin-top:5rpx}.card{background:#fff;border:1rpx solid #dfe7f2;border-radius:25rpx;box-shadow:0 10rpx 28rpx rgba(24,62,112,.06)}.filter-card{padding:21rpx}.quick{display:flex;gap:12rpx}.quick button{flex:1;margin:0;background:#e8f1ff;color:#1d4ed8;border-radius:16rpx;font-size:22rpx;font-weight:850;line-height:64rpx}.quick button::after{border:0}.date-grid{display:grid;grid-template-columns:1fr 34rpx 1fr;align-items:center;gap:7rpx;margin-top:16rpx}.date-box{padding:15rpx;background:#f7f9fc;border:1rpx solid #dce5f0;border-radius:16rpx}.date-box text,.date-box b{display:block}.date-box text{font-size:18rpx;color:#8794a6}.date-box b{font-size:23rpx;color:#213c64;margin-top:4rpx}.arrow{text-align:center;color:#91a0b4}.summary{display:grid;grid-template-columns:repeat(3,1fr);gap:11rpx;margin:16rpx 0}.summary>view{padding:19rpx 5rpx;text-align:center;background:linear-gradient(145deg,#fff,#edf4ff);border:1rpx solid #dbe6f5;border-radius:20rpx}.summary b,.summary text{display:block}.summary b{font-size:35rpx;color:#1d4ed8}.summary text{font-size:18rpx;color:#78889d;margin-top:2rpx}.result-card{padding:22rpx}.result-head{display:flex;align-items:flex-end;justify-content:space-between;padding-bottom:13rpx;border-bottom:1rpx solid #e8edf4}.result-head b{font-size:27rpx;color:#203957}.result-head text{font-size:17rpx;color:#8b98a9}.attendance-row{display:grid;grid-template-columns:48rpx 1fr 70rpx;align-items:center;gap:13rpx;padding:18rpx 0;border-bottom:1rpx solid #edf1f6}.rank{width:42rpx;height:42rpx;border-radius:14rpx;background:#e7f0ff;color:#2563eb;display:flex;align-items:center;justify-content:center;font-weight:900}.member{min-width:0}.member b,.member text{display:block}.member b{font-size:24rpx;color:#32435b}.member text{font-size:18rpx;color:#8995a5;margin-top:4rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.count{text-align:right}.count b{font-size:31rpx;color:#1d4ed8}.count text{font-size:18rpx;color:#8290a2;margin-left:3rpx}.empty{text-align:center;padding:70rpx 0;color:#8996a7;font-size:22rpx}
