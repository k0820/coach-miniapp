.page{min-height:100vh;padding:24rpx;background:#f3f6fb;box-sizing:border-box}.card{margin-bottom:20rpx;padding:28rpx;background:#fff;border:1rpx solid #e3eaf3;border-radius:24rpx;box-shadow:0 8rpx 24rpx rgba(19,43,79,.06)}.title{font-size:34rpx;font-weight:700;color:#132b4f}.hint,.hash{margin-top:10rpx;font-size:25rpx;color:#778397;word-break:break-all}.btn{margin-top:24rpx}.status{margin-top:22rpx;padding:18rpx;border-radius:14rpx;background:#eef4fc;color:#29496f;font-size:27rpx}.row,.summary-head,.summary-row{display:grid;grid-template-columns:1fr auto;gap:20rpx;padding:18rpx 0;border-bottom:1rpx solid #edf1f6;color:#37465a}.row b{color:#132b4f}.summary-head,.summary-row{grid-template-columns:1.3fr .7fr .7fr;text-align:right}.summary-head text:first-child,.summary-row text:first-child{text-align:left}.summary-head{font-weight:700;color:#132b4f}.warning{margin-top:20rpx;padding:18rpx;border-radius:14rpx;background:#fff5ea;color:#9a5b18;font-size:25rpx}
