<view class="member-home-root" data-weui-theme="light" style="{{themeStyle}}">
<scroll-view class="member-home-scroll" scroll-y enhanced show-scrollbar="{{false}}" refresher-enabled refresher-default-style="none" refresher-background="transparent" refresher-triggered="{{refreshing}}" bindrefresherrefresh="onRefresherRefresh">
<view class="member-page member-shell home-page weui-page">
  <view class="home-header">
    <view class="home-greeting"><view class="home-kicker">今天也要好好训练</view><view class="member-title">你好，{{displayName||'训练伙伴'}}</view><view class="home-greeting-sub">把每一次训练，都变成看得见的积累</view></view>
    <view class="member-fitness-mark" aria-hidden="true"><view class="member-fitness-bar"></view><view class="member-fitness-plate left"></view><view class="member-fitness-plate left outer"></view><view class="member-fitness-plate right"></view><view class="member-fitness-plate right outer"></view></view>
  </view>
  <view class="home-stat-grid">
    <view class="home-stat home-stat-mint" bindtap="packages"><view class="home-stat-icon">◷</view><view><text>剩余课时</text><b>{{vm.summary.available}}</b><small>节</small></view><i>›</i></view>
    <view class="home-stat home-stat-blue" bindtap="bookings"><view class="home-stat-icon">▣</view><view><text>下节课</text><b class="home-stat-word">{{vm.next?'已预约':'还没有'}}</b><small>{{vm.next?'查看详情':'待上课程'}}</small></view><i>›</i></view>
    <view class="home-stat home-stat-coral" bindtap="history"><view class="home-stat-icon">▥</view><view><text>近30天</text><b>{{trainingSummary.count30}}</b><small>次</small></view><i>›</i></view>
  </view>
  <view wx:if="{{notice.length}}" class="member-inline-notice"><view wx:for="{{notice}}" wx:key="*this" class="member-inline-notice-line">{{item}}</view></view>
  <view wx:if="{{incompleteText}}" class="member-inline-notice">{{incompleteText}}</view>
  <view wx:if="{{errorText}}" class="member-inline-notice member-inline-notice--error">{{errorText}}</view>
  <view wx:if="{{!snapshotReady}}" class="home-loading"><view class="home-loading-bar"></view><text>正在读取训练资料</text></view>
  <view class="home-surface balance-surface weui-panel">
    <view class="balance-head"><view><view class="surface-kicker">我的课包</view><view class="balance-total"><b>{{vm.summary.available}}</b><text>节可约</text></view></view><view class="surface-link" bindtap="packages">查看全部 ›</view></view>
    <view class="package-list" wx:if="{{vm.packages.length}}">
      <view wx:for="{{vm.packages}}" wx:key="packageKey" class="package-row"><view class="package-dot"></view><view class="package-copy"><b>{{item.typeName||'常规训练'}}</b><text>{{item.saleDate||'当前课时包'}}</text></view><view class="package-remain">{{item.available}} 节</view></view>
    </view>
    <view wx:else class="surface-empty">{{vm.emptyText}}</view>
  </view>
  <view class="home-quick-grid">
    <view class="home-actions weui-cells">
      <view class="next-card weui-cell weui-cell_access" bindtap="bookings"><view class="weui-cell__bd"><view class="surface-kicker">下一节课</view><view class="next-title">{{vm.next?vm.nextText:'还没有待上课程'}}</view><view class="next-sub">{{vm.next?(vm.next.typeName+' · '+vm.next.coachName):'预约成功后会在这里显示'}}</view></view><view class="weui-cell__ft">查看</view></view>
    </view>
    <view class="home-training weui-cells">
      <view class="training-entry weui-cell weui-cell_access" bindtap="history">
        <view class="weui-cell__bd"><view class="training-title-line"><view class="training-entry-title">训练记录</view><view class="training-count">近30天 {{trainingSummary.count30}} 次</view></view><view class="training-entry-sub">{{trainingSummary.latestText}}</view></view>
        <view class="weui-cell__ft"></view>
      </view>
    </view>
  </view>
  <view class="home-preference" bindtap="openAlias"><text>显示设置</text><text>修改我的称呼 ›</text></view>
</view>
</scroll-view>
<member-sheet visible="{{aliasOpen}}" title="修改我的称呼" desc="只在你的会员端显示，不会改变教练登记的姓名" confirmText="保存称呼" cancelText="暂不修改" bindconfirm="saveAlias" bindcancel="closeAlias" bindclose="closeAlias">
  <view class="alias-editor"><input maxlength="12" value="{{aliasDraft}}" bindinput="aliasInput" placeholder="输入你喜欢的称呼"/><view class="alias-help">留空保存会恢复教练登记的原称呼</view></view>
</member-sheet>
<member-nav active="home"/>
</view>
