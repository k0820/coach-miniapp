<view class="member-page member-shell" style="{{themeStyle}}">
  <view class="member-row member-spread">
    <view>
      <view class="member-title">首页</view>
      <view class="member-subtitle">你好，{{vm.member.displayName||'训练伙伴'}}</view>
    </view>
    <view class="member-avatar">{{vm.initial}}</view>
  </view>

  <!-- ⛔ 异常不得静默：环境不对 / 账号没读到 / 少读一份，都必须在首页说成人话 -->
  <view wx:if="{{notice.length}}" class="member-card member-empty">
    <view wx:for="{{notice}}" wx:key="*this">{{item}}</view>
  </view>
  <view wx:if="{{incompleteText}}" class="member-card member-empty">{{incompleteText}}</view>
  <view wx:if="{{errorText}}" class="member-card member-empty">{{errorText}}</view>

  <!-- ① 课时概况 -->
  <view class="member-card">
    <view class="member-section-title" style="margin-top:0">课时概况</view>
    <view class="member-row">
      <view class="home-stat"><view class="home-num">{{vm.summary.available}}</view><view class="home-label">可用课时</view></view>
      <view class="home-stat"><view class="home-num alt">{{vm.summary.occupied}}</view><view class="home-label">已占用</view></view>
      <view class="home-stat"><view class="home-num weak">{{vm.summary.used}}</view><view class="home-label">已完成</view></view>
    </view>
    <view class="member-subtitle card-foot" bindtap="packages">查看课时明细 ›</view>
    <view wx:if="{{vm.emptyText}}" class="member-subtitle" style="margin-top:10rpx">{{vm.emptyText}}</view>
  </view>

  <!-- ② 下一节课 -->
  <view class="member-card">
    <view class="member-section-title" style="margin-top:0">下一节课</view>
    <view wx:if="{{vm.next}}">
      <view class="member-row member-spread">
        <view>
          <view>{{vm.next.coachName}}</view>
          <view class="member-subtitle">{{vm.nextText}} · {{vm.next.typeName}}</view>
        </view>
        <view class="member-pill">已预约</view>
      </view>
    </view>
    <view wx:else class="member-subtitle">暂时没有待上课程</view>
  </view>

  <!-- 单教练产品：只显示资料所属教练，不再提供添加、切换或联系人码。 -->
  <view class="member-card">
    <view class="member-section-title" style="margin:0">我的教练</view>
    <scroll-view wx:if="{{vm.coaches.length}}" class="home-coaches" scroll-x enable-flex>
      <view wx:for="{{vm.coaches}}" wx:for-index="coachIndex" wx:if="{{coachIndex===0}}" wx:key="contactKey" class="home-coach" data-key="{{item.contactKey}}" bindtap="bookCoach">
        <view class="member-avatar small">{{item.displayName}}</view>
        <view class="home-coach-name">{{item.displayName}}</view>
        <view class="member-subtitle">尾号 {{item.phoneTail}}</view>
      </view>
    </scroll-view>
    <view wx:else class="member-subtitle">还没有绑定教练录入的会员资料。</view>
  </view>

  <!-- 快捷按钮 -->
  <view class="member-card member-list-row member-row member-spread" bindtap="bookSlots">
    <view>约一节课</view><view class="member-arrow">›</view>
  </view>
  <view class="member-card member-list-row member-row member-spread" bindtap="bookings">
    <view>查看预约</view><view class="member-arrow">›</view>
  </view>
  <view wx:if="{{inboxAvailable}}" class="member-card member-list-row member-row member-spread" bindtap="openInbox">
    <view>消息中心<text wx:if="{{inboxUnread>0}}" class="member-dot"> 未读 {{inboxUnread}} 条</text></view>
    <view class="member-arrow">›</view>
  </view>

  <member-nav active="home"/>
</view>

