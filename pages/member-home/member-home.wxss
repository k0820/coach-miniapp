@import "../../styles/vendor/weui-2.6.26.wxss";
@import "../../styles/member.wxss";

.member-home-root,.member-home-scroll{height:100vh;background:#f7f8f6}
.home-page{padding-top:30rpx;background:linear-gradient(180deg,#e9f7ef 0,#f7f8f6 370rpx)}
.home-header{position:relative;overflow:hidden;display:flex;align-items:center;justify-content:space-between;gap:18rpx;margin-bottom:22rpx;padding:30rpx 28rpx;border-radius:28rpx;background:#17221c;color:#fff;box-shadow:0 16rpx 40rpx rgba(23,34,28,.12)}
.home-greeting{position:relative;z-index:1;flex:1;min-width:0}.home-header .member-title{color:#fff}.home-kicker{font-size:22rpx;line-height:1.5;color:#85e5ad;font-weight:700;margin-bottom:5rpx}.home-greeting-sub{margin-top:8rpx;font-size:21rpx;line-height:1.45;color:rgba(255,255,255,.62)}.home-header .member-fitness-mark{width:124rpx;transform:rotate(-7deg);opacity:.78}.home-header .member-fitness-bar,.home-header .member-fitness-plate{background:#85e5ad}
.home-loading{display:flex;align-items:center;justify-content:center;gap:16rpx;min-height:58rpx;margin:-4rpx 0 12rpx;color:var(--weui-FG-1);font-size:21rpx}.home-loading-bar{width:42rpx;height:7rpx;border-radius:999rpx;background:linear-gradient(90deg,#31c48d,#4668e8);animation:homeLoadingPulse .9s ease-in-out infinite alternate}@keyframes homeLoadingPulse{from{opacity:.35;transform:scaleX(.62)}to{opacity:1;transform:scaleX(1)}}
.home-surface{overflow:hidden;background:var(--weui-BG-2);border-radius:24rpx;box-shadow:0 8rpx 26rpx rgba(23,34,28,.05)}
.balance-surface{margin-bottom:18rpx}.balance-head{display:flex;align-items:flex-start;justify-content:space-between;gap:22rpx;padding:30rpx 28rpx 22rpx}.surface-kicker{font-size:21rpx;color:var(--weui-FG-1)}.balance-total{display:flex;align-items:baseline;margin-top:4rpx}.balance-total b{font-size:68rpx;line-height:1.05;color:#17221c;font-weight:800;letter-spacing:-3rpx}.balance-total text{margin-left:10rpx;font-size:23rpx;color:var(--weui-FG-1);font-weight:650}.surface-link{padding:10rpx 0;color:var(--weui-BRAND);font-size:21rpx;font-weight:700}
.package-list{padding:0 28rpx}.package-row{display:flex;align-items:center;gap:16rpx;min-height:86rpx;border-top:1rpx solid var(--weui-SEPARATOR-0)}.package-dot{width:12rpx;height:12rpx;border-radius:50%;background:var(--weui-BRAND)}.package-copy{flex:1;min-width:0}.package-copy b,.package-copy text{display:block}.package-copy b{font-size:26rpx;color:var(--weui-FG-0)}.package-copy text{margin-top:2rpx;font-size:20rpx;color:var(--weui-FG-2)}.package-remain{font-size:26rpx;color:var(--weui-TEXTGREEN);font-weight:800}.surface-empty{padding:20rpx 28rpx 30rpx;color:var(--weui-FG-2);font-size:23rpx}
.home-actions.weui-cells{margin-top:0;border-radius:24rpx;overflow:hidden;background:var(--weui-BG-2);box-shadow:0 8rpx 26rpx rgba(23,34,28,.05)}.home-actions.weui-cells::before,.home-actions.weui-cells::after{display:none}.home-actions .weui-cell{padding:26rpx 28rpx}.home-actions .weui-cell::before{left:92rpx;border-color:var(--weui-SEPARATOR-0)}
.next-card{display:flex;align-items:center;gap:18rpx}.next-card .weui-cell__bd{min-width:0}.next-title{margin-top:5rpx;font-size:29rpx;line-height:1.35;color:var(--weui-FG-0);font-weight:750}.next-sub{margin-top:4rpx;font-size:21rpx;color:var(--weui-FG-1)}.home-actions .weui-cell__ft{font-size:21rpx;color:var(--weui-FG-2)}
.home-training.weui-cells{margin:18rpx 0 0;border-radius:24rpx;overflow:hidden;background:var(--weui-BG-2);box-shadow:0 8rpx 26rpx rgba(23,34,28,.05)}.home-training.weui-cells::before,.home-training.weui-cells::after{display:none}.training-entry{display:flex;align-items:center;gap:18rpx;padding:26rpx 28rpx}.training-entry .weui-cell__bd{min-width:0}.training-title-line{display:flex;align-items:baseline;justify-content:space-between;gap:16rpx}.training-entry-title{font-size:29rpx;color:var(--weui-FG-0);font-weight:750}.training-count{flex:0 0 auto;font-size:21rpx;color:var(--weui-TEXTGREEN);font-weight:750}.training-entry-sub{margin-top:5rpx;font-size:21rpx;line-height:1.45;color:var(--weui-FG-1);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}

/* 会员首页层级：主课时、下一节、训练记录分别使用不同尺寸与色彩。 */
.home-page{--home-ink:#17221c;--home-mint:#31c48d;--home-mint-deep:#168765;--home-blue:#4668e8;--home-blue-soft:#edf1ff;--home-coral:#ef754f;--home-coral-soft:#fff0e9;--home-gold:#ffc85a;padding-top:28rpx;background:linear-gradient(180deg,#eaf8f2 0,#fff9f2 520rpx,#f7f8f6 100%)}
.home-header{padding:32rpx 30rpx 34rpx;border-radius:32rpx;background:linear-gradient(135deg,#17221c 0%,#173c38 58%,#31556b 100%);box-shadow:0 18rpx 44rpx rgba(23,34,28,.16)}
.home-kicker{color:var(--home-gold)}.home-header .member-fitness-bar,.home-header .member-fitness-plate{background:var(--home-gold)}
.home-surface.balance-surface{position:relative;margin-bottom:20rpx;border:0;border-radius:30rpx;background:linear-gradient(135deg,var(--home-mint-deep),var(--home-mint));box-shadow:0 16rpx 34rpx rgba(22,135,101,.2);color:#fff}
.balance-surface .surface-kicker,.balance-surface .balance-total text,.balance-surface .package-copy text{color:rgba(255,255,255,.72)}
.balance-surface .balance-total b,.balance-surface .package-copy b,.balance-surface .package-remain{color:#fff}.balance-surface .surface-link{padding:11rpx 16rpx;border-radius:999rpx;background:rgba(255,255,255,.18);color:#fff}.balance-surface .package-row{min-height:76rpx;border-color:rgba(255,255,255,.16)}.balance-surface .package-dot{background:var(--home-gold)}
.home-quick-grid{display:flex;align-items:stretch;gap:16rpx}
.home-actions.weui-cells{flex:1.48;margin:0;border:1rpx solid #dce4ff;border-radius:26rpx;background:linear-gradient(135deg,var(--home-blue-soft),#fff);box-shadow:0 12rpx 28rpx rgba(70,104,232,.1)}.home-actions .weui-cell{position:relative;box-sizing:border-box;height:100%;min-height:168rpx;padding:24rpx 22rpx;align-items:flex-start}.home-actions .weui-cell__bd{padding-right:58rpx}.next-title{color:#1d316f;font-size:29rpx}.home-actions .weui-cell__ft{position:absolute;top:22rpx;right:18rpx;color:var(--home-blue);font-weight:750}
.home-training.weui-cells{flex:.82;margin:0;border:1rpx solid #ffd8c9;border-radius:22rpx;background:linear-gradient(145deg,var(--home-coral-soft),#fff);box-shadow:none}.training-entry{box-sizing:border-box;height:100%;min-height:168rpx;padding:24rpx 20rpx;align-items:flex-start}.training-title-line{display:block}.training-entry-title{color:#71321f;font-size:27rpx}.training-count{display:block;margin-top:14rpx;color:var(--home-coral);font-size:23rpx}.training-entry-sub{display:none}
.home-preference{display:flex;align-items:center;justify-content:space-between;margin:18rpx 8rpx 0;padding:14rpx 8rpx;color:#8b9691;font-size:20rpx}.home-preference text:last-child{color:#60706a}
.alias-editor{padding:8rpx 2rpx 18rpx}.alias-editor input{height:84rpx;padding:0 22rpx;border:1rpx solid var(--member-border);border-radius:20rpx;background:var(--member-surface-alt);color:var(--member-text);font-size:27rpx}.alias-help{margin-top:14rpx;color:var(--member-text-sub);font-size:20rpx;line-height:1.5}

/* 2026-10-23 · UI Lovelace Minimalist 样板落地：不同尺寸卡片 + 四色信息层级。 */
.member-home-root,.member-home-scroll{background:#fbfaf5}.home-page{padding:30rpx 28rpx calc(156rpx + env(safe-area-inset-bottom));background:linear-gradient(180deg,#edf9f4 0,#fffaf3 620rpx,#fbfaf5 100%)}
.home-header{min-height:210rpx;padding:34rpx 30rpx;border-radius:34rpx;background:linear-gradient(135deg,#0c302d 0%,#104b45 58%,#28566b 100%);box-shadow:0 18rpx 44rpx rgba(16,63,59,.16)}
.home-header .member-title{font-size:46rpx}.home-greeting-sub{font-size:22rpx}.home-header .member-fitness-mark{width:140rpx}
.home-stat-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:14rpx;margin:20rpx 0}.home-stat{position:relative;min-width:0;min-height:150rpx;box-sizing:border-box;padding:20rpx 16rpx;border:1rpx solid rgba(16,63,59,.08);border-radius:26rpx;display:flex;align-items:flex-start;gap:10rpx;box-shadow:0 10rpx 26rpx rgba(16,63,59,.05)}.home-stat>view:nth-child(2){min-width:0;flex:1}.home-stat text,.home-stat b,.home-stat small{display:block}.home-stat text{font-size:20rpx;color:#647772}.home-stat b{margin-top:7rpx;font-size:42rpx;line-height:46rpx;color:#103f3b}.home-stat small{font-size:18rpx;color:#71837f}.home-stat-word{font-size:26rpx!important;white-space:nowrap}.home-stat i{position:absolute;right:12rpx;top:57rpx;color:#8b9996;font-size:30rpx;font-style:normal}.home-stat-icon{width:42rpx;height:42rpx;border-radius:14rpx;display:flex;align-items:center;justify-content:center;font-size:22rpx;font-weight:800}.home-stat-mint{background:linear-gradient(145deg,#eafaf4,#fff)}.home-stat-mint .home-stat-icon{background:#c8f4e4;color:#168765}.home-stat-blue{background:linear-gradient(145deg,#edf3ff,#fff)}.home-stat-blue .home-stat-icon{background:#d9e5ff;color:#4c76df}.home-stat-coral{background:linear-gradient(145deg,#fff1ec,#fff)}.home-stat-coral .home-stat-icon{background:#ffdcd0;color:#ef7654}.home-stat-coral b{color:#df6040}
.home-surface.balance-surface{margin-bottom:20rpx;border-radius:32rpx;background:linear-gradient(135deg,#159b70,#34c99a);box-shadow:0 16rpx 38rpx rgba(21,155,112,.19)}.balance-head{padding:28rpx 28rpx 18rpx}.balance-total b{font-size:58rpx}.balance-surface .package-row{min-height:72rpx}.balance-surface .package-dot{background:#f3b941}
.home-quick-grid{gap:16rpx}.home-actions.weui-cells{flex:1.55;border-radius:28rpx;background:linear-gradient(145deg,#edf3ff,#fff);border-color:#dbe6ff}.home-actions .weui-cell{min-height:184rpx;padding:28rpx 22rpx}.home-training.weui-cells{flex:.85;border-radius:28rpx;background:linear-gradient(145deg,#fff1ec,#fff)}.training-entry{min-height:184rpx;padding:28rpx 20rpx}.training-entry-title{font-size:29rpx}.training-count{font-size:24rpx}.home-preference{margin-top:24rpx;padding-top:18rpx;border-top:1rpx solid rgba(16,63,59,.08)}
