<page-meta page-style="{{historyModal || salesDetailModal || settingsModal || saleModal ? 'overflow: hidden;' : ''}}"/>
<view wx:if="{{reversingSaleId}}" class="inline-save-status">正在撤销，请稍候…</view>
<sandbox-banner/>
<view class="page stats-page">
  <!-- 月份切换统一入口：页首本月大标题 + 「按月查看」（原顶部「历史结算」按钮） -->
  <view class="stats-head">
    <view class="stats-head-copy"><view class="stats-month">{{monthTitle}}</view><view class="stats-month-sub">本月数据 · 完课收入与销售业绩独立计算</view></view>
    <view class="stats-head-entry" hover-class="stats-head-entry-on" bindtap="openHistory">按月查看 ›</view>
  </view>
  <view class="card overview-section">
    <view class="overview-numbers">
      <view class="overview-number"><text>上课收入</text><b>¥{{classRevenue}}</b><text class="metric-note">提成 {{classCommissionRate}}% · ¥{{classCommission}}</text></view>
      <view class="overview-number"><text>销售业绩</text><b class="adaptive-money">¥{{salesRevenue}}</b><text class="metric-note">提成 {{salesCommissionRate}}% · ¥{{salesCommission}}</text></view>
      <view class="commission-total"><view><text>预计提成</text><text class="metric-note">按当前提成比例计算</text></view><b>¥{{estimatedCommission}}</b></view>
    </view>
    <view class="breakdown-area">
      <view class="breakdown-group"><view class="breakdown-title">上课构成</view><view wx:for="{{classSegments}}" wx:key="name" class="breakdown-row"><view><i style="background:{{item.color}}"></i><text>{{item.name}}</text></view><b>¥{{item.amount}}</b></view><view wx:if="{{!classSegments.length}}" class="breakdown-empty">暂无上课收入</view><view wx:if="{{giftCount}}" class="breakdown-row gift-row"><view><text>赠送课程 · {{giftCount}} 节</text></view><b>¥{{giftRevenue}}</b></view></view>
      <view class="breakdown-group"><view class="breakdown-title">业绩构成</view><view wx:for="{{salesSegments}}" wx:key="name" class="breakdown-row"><view><i style="background:{{item.color}}"></i><text>{{item.name}}</text></view><b>¥{{item.amount}}</b></view><view wx:if="{{!salesSegments.length}}" class="breakdown-empty">暂无销售业绩</view></view>
    </view>
    <!-- 紧凑数据卡：原 attendance-summary 三项 + goal-line 进度条合并为四格 -->
    <view class="stat-mini-row"><view class="stat-mini"><b>{{monthSessions}}</b><text>完成课时</text></view><view class="stat-mini"><b>{{ranking.length}}</b><text>上课会员</text></view><view class="stat-mini"><b>{{monthlyGoalSessions}}</b><text>本月目标</text></view><view class="stat-mini"><b>{{monthSessions}}/{{monthlyGoalSessions}}</b><text>目标进度</text></view></view>
    <button wx:if="{{salesList.length}}" class="text-entry" bindtap="openSalesDetail">查看本月业绩明细（{{salesList.length}}）<text>›</text></button>
    <!-- 「＋ 其他业绩」保留原入口与文案，层级从实心主按钮降为卡内文字入口，主入口让给页首「按月查看」 -->
    <button class="text-entry" bindtap="openSale">＋ 其他业绩<text>›</text></button>
  </view>
  <view class="card attendance-section">
    <view class="section-head compact-head"><view><view class="title">会员出勤排行</view><view class="hint">本月完成情况 · 点会员看明细</view></view><view class="stats-head-entry" hover-class="stats-head-entry-on" bindtap="openAttendanceHistory">按日期查询 ›</view></view>
    <view wx:if="{{!ranking.length}}" class="empty-small">暂无完课数据</view>
    <block wx:for="{{ranking}}" wx:key="id"><view wx:if="{{index<5||showAllRanking}}" class="rank" data-i="{{index}}" bindtap="toggle"><view class="row spread"><view><text class="rank-index">{{index+1}}</text>{{item.name}}</view><view class="count">{{item.count}} 次</view></view><view wx:if="{{item.open}}" class="detail">{{item.name}} {{item.count}} 次：{{item.detail}}</view></view></block>
    <button wx:if="{{ranking.length>5}}" class="text-entry ranking-more" bindtap="toggleRanking">{{showAllRanking?'收起其余学员':'查看全部学员'}}<text>›</text></button>
  </view>
  <!-- 🔔 2026-10-06：教练端统一通知入口（⛔ 不再藏在某个学员的认领页里） -->
  <!-- 📥 2026-10-06 需求五：教练端消息中心（⛔ 正式区没有这套集合 ⇒ 入口整个藏起来） -->
  <view wx:if="{{inboxAvailable}}" class="card settings-entry ghost-entry" bindtap="openInbox"><view><view class="title">消息中心<text wx:if="{{inboxUnread>0}}" class="inbox-badge"> 未读 {{inboxUnread}} 条</text></view><view class="hint">预约与课程变动都在这里，不受微信次数限制</view></view><text class="entry-arrow">›</text></view>
  <view class="card settings-entry ghost-entry" bindtap="openSettings"><view><view class="title">设置与数据</view><view class="hint">提成比例、课时目标与数据备份</view></view><text class="entry-arrow">›</text></view>
  <!-- 体验版只开放隔离 Sandbox；正式 release 隐藏。其他诊断/切换入口继续由开发开关隐藏。 -->
  <navigator wx:if="{{sandboxEntry}}" class="sandbox-entry" url="/pages/sandbox-control/sandbox-control">测试环境 · 使用假数据安全测试 ›</navigator>
  <block wx:if="{{devEntries}}">
    <navigator wx:if="{{!sandboxMode}}" class="sandbox-entry" url="/pkg-diag/production-recovery-diagnostic/production-recovery-diagnostic">临时 · 上午课程只读恢复诊断 ›</navigator>
  </block>
</view>
<view wx:if="{{historyModal}}" class="sale-mask" bindtap="closeHistory" catchtouchmove="noop"><scroll-view scroll-y class="sale-dialog history-dialog" catchtap="noop"><view class="row spread"><view><view class="title">历史结算</view><view class="hint">按月份查看课时结算与销售业绩</view></view><view class="dialog-x" bindtap="closeHistory">×</view></view><view class="history-tabs"><view class="{{historyTab==='classes'?'active':''}}" data-tab="classes" bindtap="switchHistoryTab">课时结算</view><view class="{{historyTab==='sales'?'active':''}}" data-tab="sales" bindtap="switchHistoryTab">销售业绩</view></view><picker mode="date" fields="month" value="{{historyMonth}}" bindchange="historyMonth"><view class="history-month"><text>查看月份</text><b>{{historyLabel}}</b><text>›</text></view></picker><block wx:if="{{historyTab==='classes'}}"><view class="history-totals"><view><text>上课金额</text><b>¥{{historyClass}}</b></view><view><text>完成课时</text><b>{{historyClassCount}} 节</b></view><view><text>综合预计提成</text><b>¥{{historyCommission}}</b></view></view><view class="history-section"><view wx:if="{{historyClassList.length}}" class="history-table-head"><text>会员</text><text>节数</text><text>金额</text></view><view wx:if="{{!historyClassList.length}}" class="empty-small">这个月暂无上课记录</view><view wx:for="{{historyClassList}}" wx:key="id" class="history-student-row" data-i="{{index}}" bindtap="toggleHistoryStudent"><view class="history-main"><b>{{item.name}}</b><text>{{item.count}} 节</text><text class="history-amount">¥{{item.amount}}</text></view><view class="history-types">{{item.typeText}}</view><view class="history-lesson-entry">{{item.open?'收起课程明细':'展开课程明细'}} ›</view><view wx:if="{{item.open}}" class="history-lessons"><view wx:for="{{item.lessons}}" wx:for-item="lesson" wx:for-index="lessonIndex" wx:key="key" class="history-lesson"><view class="history-lesson-top"><text class="history-lesson-date">{{lesson.date}}</text><text class="history-lesson-time">{{lesson.timeText}}</text><text class="history-lesson-amount">¥{{lesson.amount}}</text></view><view class="history-lesson-meta"><text>{{lesson.typeName}}</text><text>{{lesson.durationText}}</text><text>{{lesson.statusText}}</text></view></view></view></view></view></block><block wx:else><view class="history-totals history-sales-totals"><view><text>销售业绩</text><b>¥{{historySales}}</b></view><view><text>销售提成</text><b>¥{{historySalesCommission}}</b></view><view><text>销售笔数</text><b>{{historySalesList.length}} 笔</b></view></view><view class="history-section"><view class="history-section-title">销售明细</view><view wx:if="{{!historySalesList.length}}" class="empty-small">这个月暂无销售业绩</view><view wx:for="{{historySalesList}}" wx:key="id" class="history-row"><view><b>{{item.displayName}}</b><text wx:if="{{item.source==='course'}}">{{item.typeName}} · {{item.quantity}} 节{{item.unitPrice!=null?' · ¥'+item.unitPrice+'/节':''}}</text><text wx:else>{{item.typeName||'其他业绩'}} · 手动记录</text><text>{{item.date}}</text></view><view class="history-sale-side"><text class="history-amount">¥{{item.amount}}</text><view wx:if="{{!item.legacyReadonly}}" class="sale-item-actions"><picker mode="multiSelector" range="{{item.editDateRange}}" value="{{item.editDateValue}}" data-id="{{item.id}}" bindcolumnchange="historySaleDateColumnChange" bindchange="historySaleDateChange"><text class="sale-edit">编辑日期</text></picker><text class="sale-delete" data-id="{{item.id}}" catchtap="deleteSale">{{item.source==='course'?'撤销':'删除'}}</text></view></view></view></view></block></scroll-view></view>
<view wx:if="{{salesDetailModal}}" class="sale-mask" bindtap="closeSalesDetail" catchtouchmove="noop"><scroll-view scroll-y class="sale-dialog detail-dialog" catchtap="noop"><view class="row spread"><view class="title">本月业绩明细</view><view class="dialog-x" bindtap="closeSalesDetail">×</view></view><view wx:for="{{salesList}}" wx:key="id" class="sale-row"><view><b>{{item.displayName}}</b><text wx:if="{{item.source==='course'}}">{{item.typeName}} · {{item.quantity}} 节{{item.unitPrice!=null?' · ¥'+item.unitPrice+'/节':''}}</text><text wx:else>{{item.typeName||'其他业绩'}} · 手动记录</text><text>{{item.date}} {{item.validTo?'· 有效至 '+item.validTo:''}}</text></view><view class="sale-row-side"><text class="sale-amount">{{item.legacyReadonly?' · 历史只读':''}}</text><text class="sale-amount">¥{{item.amount}}</text><view wx:if="{{!item.legacyReadonly}}" class="sale-item-actions"><picker mode="date" value="{{item.date}}" data-id="{{item.id}}" bindchange="editSaleDate"><text class="sale-edit">编辑日期</text></picker><text class="sale-delete" data-id="{{item.id}}" catchtap="deleteSale">{{item.source==='course'?'撤销':'删除'}}</text></view></view></view></scroll-view></view>
<view wx:if="{{settingsModal}}" class="sale-mask" bindtap="closeSettings" catchtouchmove="noop"><scroll-view scroll-y class="sale-dialog settings-dialog" catchtap="noop"><view class="row spread"><view><view class="title">设置与数据</view><view class="hint">统计偏好与本机数据管理</view></view><view class="dialog-x" bindtap="closeSettings">×</view></view><view class="settings-group"><view class="settings-title">提成设置</view><view class="setting-grid"><view><view class="label">上课提成比例（%）</view><input class="input compact-input" type="digit" value="{{classCommissionRate}}" data-k="classCommissionRate" bindinput="setting"/></view><view><view class="label">销售提成比例（%）</view><input class="input compact-input" type="digit" value="{{salesCommissionRate}}" data-k="salesCommissionRate" bindinput="setting"/></view></view><view class="setting-note">提成比例输入后自动保存</view></view><view class="settings-group"><view class="settings-title">课时设置</view><view class="setting-grid"><view><view class="label">剩余课时提醒阈值</view><input class="input compact-input" type="number" value="{{renewThreshold}}" data-k="renewThreshold" bindinput="setting"/></view><view><view class="label">月课时目标</view><input class="input compact-input" type="number" value="{{monthlyGoalSessions}}" data-k="monthlyGoalSessions" bindinput="setting"/></view></view><button class="btn ghost compact-button save-settings-button" bindtap="saveSettings">保存课时设置</button></view><view wx:if="{{!sandboxMode}}" class="settings-group data-actions"><view class="settings-title">数据安全</view><view class="safety-list"><view class="safety-item" catchtap="backupCoachDBToCloud"><view><b>云端完整备份</b><text>{{cloudBackupLoading?'正在上传…':'复制一份到当前微信的云空间'}}</text></view><text class="safety-arrow">›</text></view><view class="safety-item" catchtap="verifyCloudBackup"><view><b>验证云端备份</b><text>{{cloudVerifyLoading?'正在检查…':'只检查，不会覆盖本机数据'}}</text></view><text class="safety-arrow">›</text></view><view class="safety-item" catchtap="restoreFromCloud"><view><b>从云端恢复</b><text>恢复前会自动备份当前本机数据</text></view><text class="safety-arrow">›</text></view><view class="safety-item" bindtap="exportDB"><view><b>数据备份</b><text>复制当前完整数据</text></view><text class="safety-arrow">›</text></view><view class="safety-item" bindtap="importDB"><view><b>从备份恢复</b><text>从剪贴板导入备份数据</text></view><text class="safety-arrow">›</text></view><view class="safety-item" bindtap="restoreLocal"><view><b>恢复上一次本机数据</b><text>恢复最近一次本地保存的数据</text></view><text class="safety-arrow">›</text></view><view class="safety-item danger-item" catchtap="deleteMyAllData"><view><b>删除我的全部数据</b><text>{{deleteDataLoading?'正在删除…':'删除本机数据及当前微信的云端备份'}}</text></view><text class="safety-arrow">›</text></view></view><view wx:if="{{cloudVerifyResult}}" class="cloud-verify-result"><b>{{cloudVerifyResult.status}}</b><text>云端备份：第 {{cloudVerifyResult.version}} 版 · Schema {{cloudVerifyResult.schemaVersion||'-'}}</text><text>完整性：{{cloudVerifyResult.integrity}}</text><text>与本机：{{cloudVerifyResult.localComparison}}</text><text>最后备份：{{cloudVerifyResult.updatedAt}}</text><text wx:if="{{cloudVerifyResult.byteSize}}">数据大小：{{cloudVerifyResult.byteSize}} 字节</text><text class="verify-detail">{{cloudVerifyResult.detail}}</text></view><view wx:if="{{cloudBackupStatus}}" class="hint backup-hint">{{cloudBackupStatus}}</view><view class="hint backup-hint">建议定期复制备份，发送到自己的微信文件传输助手。</view></view></scroll-view></view>
<view wx:if="{{saleModal}}" class="sale-mask" bindtap="closeSale" catchtouchmove="noop"><scroll-view scroll-y class="sale-dialog sale-form-dialog" catchtap="noop"><view class="row spread"><view class="title">记录其他业绩</view><view class="dialog-x" bindtap="closeSale">×</view></view><view class="label">项目名称（月卡、季卡等）</view><input class="input compact-input" value="{{sale.name}}" data-k="name" bindinput="saleField"/><view class="label">业绩金额（支持小数，如 234.34）</view><input class="input compact-input" type="digit" value="{{sale.amount}}" data-k="amount" bindinput="saleField" placeholder="0.00"/><view class="label">成交日期</view><picker mode="date" value="{{sale.date}}" data-k="date" bindchange="saleField"><view class="input compact-input">{{sale.date}}</view></picker><view class="row validity"><view><view class="label">生效日期</view><picker mode="date" value="{{sale.validFrom}}" data-k="validFrom" bindchange="saleField"><view class="input compact-input">{{sale.validFrom}}</view></picker></view><view><view class="label">到期日期</view><picker mode="date" value="{{sale.validTo}}" data-k="validTo" bindchange="saleField"><view class="input compact-input">{{sale.validTo||'选择日期'}}</view></picker></view></view><view class="label">备注</view><input class="input compact-input" value="{{sale.note}}" data-k="note" bindinput="saleField"/><button class="btn primary compact-button" bindtap="saveSale">保存其他业绩</button><view class="close-sale" bindtap="closeSale">取消</view></scroll-view></view>
