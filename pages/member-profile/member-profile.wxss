@import "../../styles/vendor/weui-2.6.26.wxss";
@import "../../styles/member.wxss";

/* 2026-10-23 · 与会员首页同一套森林绿、薄荷绿、浅蓝和珊瑚橙。 */
.profile-page{background:linear-gradient(180deg,#edf9f4 0,#fffaf3 430rpx,#fbfaf5 100%)}
.profile-head{background:linear-gradient(135deg,#103f3b,#176e68);border-radius:32rpx;box-shadow:0 18rpx 42rpx rgba(16,63,59,.14)}
.profile-head .member-avatar.big{background:linear-gradient(145deg,#d9fff1,#a8efd4);color:#103f3b}
.profile-list.weui-cells{background:transparent;box-shadow:none;display:grid;grid-template-columns:1fr 1fr;gap:18rpx;overflow:visible}
.profile-list .member-list-row{border-radius:24rpx;padding:24rpx;min-height:142rpx;box-sizing:border-box;align-items:flex-start;box-shadow:0 10rpx 24rpx rgba(16,63,59,.05)}
.profile-list .member-list-row:first-child{background:linear-gradient(145deg,#eafaf4,#fff);border:1rpx solid #ccefe0}
.profile-list .member-list-row.training-row{background:linear-gradient(145deg,#fff1ec,#fff);border:1rpx solid #f7d8cf}
.profile-list .weui-cell::before{display:none}
.profile-list .profile-row-title-line{display:block}.profile-list .training-count{display:inline-flex;margin-top:8rpx;background:#fff;color:#dd6848}
.name-sheet{background:#fbfaf5}.name-input{background:#fff}.name-btn:not(.ghost){background:linear-gradient(135deg,#22a77a,#176e68)}

.profile-page{padding-top:30rpx;background:linear-gradient(180deg,#e9f7ef 0,#f7f8f6 390rpx)}
.profile-head{position:relative;overflow:hidden;display:flex;align-items:center;gap:22rpx;min-height:184rpx;padding:32rpx;border-radius:28rpx;background:#17221c;box-sizing:border-box;box-shadow:0 16rpx 40rpx rgba(23,34,28,.12)}.profile-orb{position:absolute;right:-48rpx;top:-70rpx;width:205rpx;height:205rpx;border-radius:50%;background:rgba(133,229,173,.12)}.profile-copy,.member-avatar.big{position:relative}.profile-copy{flex:1;min-width:0}.member-avatar.big{width:86rpx;height:86rpx;border-radius:24rpx;font-size:32rpx;color:#17221c;background:#85e5ad}.profile-head .member-title{color:#fff}.profile-head .member-subtitle{color:rgba(255,255,255,.58)}.profile-head .member-fitness-mark{position:absolute;right:22rpx;bottom:16rpx;width:112rpx;opacity:.55;transform:rotate(-8deg)}.profile-head .member-fitness-bar,.profile-head .member-fitness-plate{background:#85e5ad}
.profile-rename{display:inline-flex;margin-top:9rpx;font-size:22rpx;color:#85e5ad;font-weight:700;padding:6rpx 0}.profile-loading{display:flex;align-items:center;justify-content:center;gap:24rpx;min-height:100rpx;color:var(--weui-FG-1);font-size:23rpx}
.profile-list.weui-cells{margin-top:22rpx;border-radius:24rpx;overflow:hidden;background:var(--weui-BG-2);box-shadow:0 8rpx 26rpx rgba(23,34,28,.05)}.profile-list.weui-cells::before,.profile-list.weui-cells::after{display:none}.profile-list .weui-cell{padding:28rpx}.profile-list .weui-cell::before{left:96rpx;border-color:var(--weui-SEPARATOR-0)}.profile-list .weui-cell__bd{min-width:0}.profile-row-icon{flex:0 0 auto;width:50rpx;height:50rpx;margin-right:18rpx;border-radius:16rpx;display:flex;align-items:center;justify-content:center;font-size:21rpx;font-weight:800}.package-icon{color:#285d44;background:#e8f7ee}.training-icon{color:#fff;background:var(--weui-BRAND)}.profile-row-title-line{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.profile-row-title{font-size:28rpx;line-height:1.35;font-weight:740;color:var(--weui-FG-0)}.profile-row-sub{font-size:21rpx;line-height:1.5;color:var(--weui-FG-1);margin-top:4rpx;white-space:normal}.training-count{flex:0 0 auto;padding:5rpx 12rpx;border-radius:999rpx;background:#e8f7ee;color:var(--weui-TEXTGREEN);font-size:19rpx;font-weight:700}
.name-mask{position:fixed;inset:0;background:var(--member-sheet-mask,rgba(15,30,50,.45));z-index:60}.name-sheet{position:fixed;left:0;right:0;bottom:0;z-index:61;background:var(--member-surface,#fff);border-radius:32rpx 32rpx 0 0;padding:0 28rpx calc(24rpx + env(safe-area-inset-bottom));box-shadow:0 -10rpx 40rpx rgba(15,30,50,.18)}.name-handle{width:72rpx;height:8rpx;border-radius:999rpx;background:var(--member-border,#e6ecf3);margin:16rpx auto 12rpx}.name-title{font-size:30rpx;font-weight:850;color:var(--member-text,#1d2939)}.name-sub{margin-top:10rpx;font-size:23rpx;line-height:1.6;color:var(--member-muted,#7b8798)}.name-input{margin-top:18rpx;height:var(--member-btn-height,88rpx);padding:0 20rpx;font-size:28rpx;color:var(--member-text,#1d2939);background:var(--member-page,#f4f7fb);border:2rpx solid var(--member-border,#e6ecf3);border-radius:18rpx}.name-actions{display:flex;gap:16rpx;margin-top:22rpx}.name-btn{flex:1;height:var(--member-btn-height,88rpx);line-height:var(--member-btn-height,88rpx);text-align:center;border-radius:20rpx;font-size:28rpx;font-weight:800}.name-btn.ghost{background:var(--member-page,#f4f7fb);color:var(--member-text,#1d2939)}.name-btn:not(.ghost){background:var(--weui-BRAND);color:#fff}.name-btn.disabled{opacity:.55}

