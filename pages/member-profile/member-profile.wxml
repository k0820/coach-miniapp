<view class="member-page member-shell profile-page weui-page" data-weui-theme="light" style="{{themeStyle}}"><member-sandbox-banner/>
  <!-- ① 顶部：昵称 + 会员编号 + 编辑昵称 -->
  <view class="profile-head">
    <view class="profile-orb"></view>
    <view class="member-avatar big">{{initial}}</view>
    <view class="profile-copy">
      <view class="member-title">{{member.displayName||'训练伙伴'}}</view>
      <view class="member-subtitle">会员编号 · {{publicCode||'正在生成'}}</view>
      <view wx:if="{{canRename}}" class="profile-rename" bindtap="openName">编辑昵称 ›</view>
    </view>
    <view class="member-fitness-mark" aria-hidden="true"><view class="member-fitness-bar"></view><view class="member-fitness-plate left"></view><view class="member-fitness-plate left outer"></view><view class="member-fitness-plate right"></view><view class="member-fitness-plate right outer"></view></view>
  </view>

  <view wx:if="{{errorText}}" class="member-inline-notice member-inline-notice--error">{{errorText}}</view>

  <view wx:if="{{!snapshotReady}}" class="profile-loading"><view class="wx_dot_loading"></view><text>正在同步会员资料</text></view>

  <!-- 首页已经提供预约入口；这里用一组微信原生风格列表承载课包与训练。 -->
  <view class="profile-list weui-cells">
    <view class="member-list-row weui-cell weui-cell_access" bindtap="packages">
      <view class="profile-row-icon package-icon">包</view><view class="weui-cell__bd"><view class="profile-row-title">我的课包</view><view class="profile-row-sub">查看每种课程的剩余课时</view></view><view class="weui-cell__ft"></view>
    </view>
    <view class="member-list-row training-row weui-cell weui-cell_access" bindtap="history">
      <view class="profile-row-icon training-icon">练</view><view class="weui-cell__bd"><view class="profile-row-title-line"><view class="profile-row-title">训练记录</view><view class="training-count">近30天 {{trainingSummary.count30}} 次</view></view><view class="profile-row-sub">{{trainingSummary.latestText}} · 查看动作和教练总结</view></view><view class="weui-cell__ft"></view>
    </view>
  </view>

  <view wx:if="{{nameOpen}}" class="name-mask" catchtouchmove="noop" bindtap="closeName"></view>
  <view wx:if="{{nameOpen}}" class="name-sheet">
    <view class="name-handle"></view>
    <view class="name-title">改一下你的昵称</view>
    <view class="name-sub">这个昵称会显示给已经添加你的教练。会员编号和微信身份不会改变。</view>
    <input class="name-input" value="{{nameDraft}}" maxlength="30" placeholder="给自己起个名字" bindinput="onNameInput"/>
    <view class="name-actions">
      <view class="name-btn ghost" bindtap="closeName">取消</view>
      <view class="name-btn {{nameBusy?'disabled':''}}" bindtap="saveName">{{nameBusy?'保存中…':'保存'}}</view>
    </view>
  </view>
  <member-nav active="profile"/>
</view>

