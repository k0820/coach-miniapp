<view class="member-page member-shell" style="{{themeStyle}}"><view class="member-title">添加教练</view><view class="member-subtitle">输入教练编号，或者扫描教练二维码</view>
<view wx:if="{{way==='choose'}}"><view class="member-card add-big" bindtap="chooseCode"><view><view class="member-section-title">输入教练编号</view><view class="member-subtitle">例如 C12AB34CD</view></view><view class="member-arrow">›</view></view><view class="member-card add-big" bindtap="chooseScan"><view><view class="member-section-title">扫描二维码</view><view class="member-subtitle">扫教练给你的码</view></view><view class="member-arrow">›</view></view><button class="member-ghost" bindtap="myQr">我的会员二维码（让教练扫我）</button></view>
<view wx:if="{{way==='code'}}" class="member-card"><input class="member-input" maxlength="9" value="{{code}}" placeholder="请输入 C 开头的完整教练编号" bindinput="onCode"/><button class="member-primary" loading="{{looking}}" disabled="{{busy}}" bindtap="lookup">查找教练</button><button class="member-ghost" bindtap="chooseScan">改用扫码</button></view>
<view wx:if="{{card}}" class="member-card"><view class="member-section-title">{{card.displayName}}</view><view class="member-subtitle">{{card.roleText}} · {{card.publicCode}}</view><button class="member-primary" loading="{{adding}}" bindtap="add">添加教练</button><view class="member-subtitle">添加后你就能主动约课，不需要对方同意。添加本身不发微信提醒；真正预约课程时，被预约的一方才收到提醒。</view><view class="member-ghost" bindtap="cancel">换一个</view></view><view wx:if="{{note}}" class="member-card member-empty">{{note}}</view></view>

