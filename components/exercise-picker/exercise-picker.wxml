<view class="picker-card">
  <view class="picker-heading"><view><view class="heading">选择训练动作</view><view class="heading-note">点一下直接加入本节课程</view></view><view class="heading-badge">动作库</view></view>
  <view class="search-box"><text class="search-icon">⌕</text><input class="search" placeholder="搜索动作名称" bindinput="search" /></view>
  <scroll-view scroll-x class="groups"><view class="group-row"><view wx:for="{{groups}}" wx:key="*this" class="group {{group===item?'on':''}}" data-group="{{item}}" bindtap="chooseGroup">{{item}}</view></view></scroll-view>
  <view wx:for="{{sections}}" wx:for-item="section" wx:key="group" class="lib-section"><view class="lib-heading"><text>{{section.group}}</text><text>{{section.items.length}} 个动作</text></view><view class="flow"><view wx:for="{{section.items}}" wx:for-item="exercise" wx:key="key" class="exercise-card {{flash===exercise.name?'flash':''}}" data-item="{{exercise}}" bindtap="choose" bindlongpress="manageCustom"><view class="exercise-copy"><view class="exercise">{{exercise.name}}</view></view><view wx:if="{{exercise.isCustom}}" class="exercise-kind">自</view><view class="exercise-add">{{flash===exercise.name?'✓':'＋'}}</view></view></view></view>
  <view wx:if="{{!sections.length}}" class="empty">没有匹配动作，可在下方自定义</view>
  <view class="hint">长按任意动作，可以修改名称或从动作库删除</view><view class="custom-title">{{editingIndex>=0 || editingBuiltinKey?'修改动作':'添加自定义动作'}}</view><view class="custom"><input class="custom-input" value="{{customValue}}" placeholder="例如：哈克推肩" bindinput="customInput" confirm-type="done" bindconfirm="addCustom"/><picker class="custom-group-picker" range="{{customGroups}}" value="{{customGroupIndex}}" bindchange="customGroup"><view>{{customGroup}}部⌄</view></picker><button class="custom-button" bindtap="addCustom">{{editingIndex>=0 || editingBuiltinKey?'保存':'添加'}}</button></view><view wx:if="{{editingIndex>=0 || editingBuiltinKey}}" class="cancel-custom-edit" bindtap="cancelEdit">取消修改</view>
</view>
