.picker-card{margin-bottom:18rpx;padding:21rpx;background:#fff;border:1rpx solid #e5eaf0;border-radius:23rpx;box-shadow:0 5rpx 16rpx rgba(19,43,79,.035)}
.picker-heading{display:flex;align-items:center;justify-content:space-between;gap:18rpx}.heading{font-size:30rpx;font-weight:900;color:#132b4f}.heading-note{margin-top:4rpx;font-size:20rpx;color:#7b8ba0}.heading-badge{flex:none;padding:8rpx 14rpx;border-radius:999rpx;background:#e7f8f4;color:#157c72;font-size:19rpx;font-weight:800}
.search-box{height:78rpx;margin-top:18rpx;display:flex;align-items:center;gap:10rpx;padding:0 18rpx;background:#f4f7fb;border:1rpx solid #dfe7f1;border-radius:18rpx}.search-icon{color:#718399;font-size:31rpx;line-height:1}.search{flex:1;min-width:0;height:78rpx;font-size:24rpx;color:#1f3657}
.groups{white-space:nowrap;margin:16rpx 0 2rpx}.group-row{display:flex;gap:9rpx}.group{display:inline-flex;align-items:center;justify-content:center;min-width:68rpx;height:54rpx;padding:0 18rpx;background:#f1f5f9;color:#607189;border:1rpx solid transparent;border-radius:15rpx;font-size:21rpx;font-weight:750;box-sizing:border-box}.group.on{background:#153b62;color:#fff;border-color:#153b62;box-shadow:0 6rpx 14rpx rgba(21,59,98,.14)}
.lib-section{margin-top:20rpx}.lib-heading{display:flex;align-items:center;justify-content:space-between;margin-bottom:12rpx;color:#17365c}.lib-heading text:first-child{font-size:24rpx;font-weight:900}.lib-heading text:last-child{font-size:18rpx;font-weight:600;color:#98a4b4}
.flow{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:7rpx}.exercise-card{position:relative;min-width:0;min-height:60rpx;display:flex;align-items:center;padding:7rpx 29rpx 7rpx 10rpx;background:#fff;border:1rpx solid #e2e8ef;border-radius:11rpx;box-sizing:border-box;transition:transform .15s,background .15s,border-color .15s}.exercise-card:active{transform:scale(.975);background:#f1f7f6;border-color:#a7d6cf}.exercise-copy{min-width:0;flex:1}.exercise{display:-webkit-box;overflow:hidden;-webkit-box-orient:vertical;-webkit-line-clamp:2;line-height:1.18;color:#24374f;font-size:18rpx;font-weight:760;overflow-wrap:anywhere}.exercise-kind{position:absolute;right:6rpx;bottom:6rpx;width:21rpx;height:21rpx;display:flex;align-items:center;justify-content:center;border-radius:6rpx;background:#f1f4f8;color:#7a899b;font-size:12rpx;font-weight:750}.exercise-add{position:absolute;right:6rpx;top:6rpx;width:22rpx;height:22rpx;display:flex;align-items:center;justify-content:center;border-radius:7rpx;background:#e8f5f2;color:#147b70;font-size:15rpx;font-weight:800}.exercise-card.flash{background:#edf8f6;border-color:#7fc9be}.exercise-card.flash .exercise-add{background:#15877b;color:#fff}.exercise-card.flash .exercise{color:#126b63}
.empty{text-align:center;color:#8795a7;padding:28rpx 0}.hint{margin-top:18rpx;padding:14rpx 16rpx;background:#f5f8fb;border-radius:14rpx;color:#7b899a;font-size:19rpx;line-height:1.45}.custom-title{margin-top:21rpx;padding-top:20rpx;border-top:1rpx solid #e7edf4;color:#17365c;font-size:22rpx;font-weight:900}.custom{display:flex;gap:9rpx;margin-top:12rpx}.custom-input{min-width:0;flex:1;height:72rpx;padding:0 16rpx;background:#fff;border:1rpx solid #d9e3ef;border-radius:16rpx;font-size:21rpx}.custom-group-picker{flex:none;height:72rpx;line-height:72rpx;padding:0 13rpx;background:#f1f5f9;border:1rpx solid #d9e3ef;border-radius:16rpx;color:#24476f;font-size:20rpx;font-weight:800}.custom-button{width:91rpx;height:72rpx;line-height:72rpx;margin:0;padding:0;background:#153b62;color:#fff;border:0;border-radius:16rpx;font-size:20rpx;font-weight:850}.custom-button::after{border:0}.cancel-custom-edit{text-align:center;padding:14rpx 0 0;color:#77879a;font-size:20rpx}

/* 2026-10-23 · 动作库紧凑三列，按训练部位使用四色层级。 */
.picker-card{border-color:#e3ebe7;border-radius:28rpx;background:#fff;box-shadow:0 10rpx 26rpx rgba(16,63,59,.05)}.heading{color:#102a2b}.heading-badge{background:#eafaf4;color:#176e68}.search-box{background:#f3f7f5;border-color:#e3ebe7}.group.on{background:#103f3b;border-color:#103f3b}.exercise-card{border-color:#dce7fa;background:linear-gradient(145deg,#edf3ff,#fff)}.exercise-card:nth-child(3n+2){border-color:#d7eee5;background:linear-gradient(145deg,#eafaf4,#fff)}.exercise-card:nth-child(3n){border-color:#f7d7cc;background:linear-gradient(145deg,#fff1ec,#fff)}.exercise-add{background:#dff7ee;color:#176e68}.custom-button{background:#103f3b}
