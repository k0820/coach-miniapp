.picker-card{background:#fffdf9;border:1rpx solid rgba(48,55,66,.055);border-radius:28rpx;padding:25rpx;margin-bottom:18rpx;box-shadow:0 10rpx 30rpx rgba(45,39,33,.05)}.heading{font-size:30rpx;font-weight:850;color:#26354a}.search{height:80rpx;background:#f5f2ed;border:2rpx solid #e7e1d9;border-radius:19rpx;padding:0 21rpx;margin-top:17rpx;font-size:25rpx}.groups{white-space:nowrap;margin:17rpx 0}.group-row{display:flex;gap:10rpx}.group{display:inline-block;background:#f0ece6;color:#696862;border-radius:999rpx;padding:10rpx 20rpx;font-size:22rpx;font-weight:650}.group.on{background:#26354a;color:#fff;box-shadow:0 7rpx 16rpx rgba(38,53,74,.18)}.lib-section{margin-top:20rpx;padding-top:2rpx}.lib-heading{font-size:23rpx;font-weight:850;color:#26354a;border-left:7rpx solid #e47752;padding-left:12rpx;margin-bottom:12rpx}.flow{display:flex;flex-wrap:wrap;gap:11rpx}.exercise{background:#f1ede7;color:#50545a;border:1rpx solid transparent;border-radius:999rpx;padding:10rpx 17rpx;font-size:22rpx;transition:.15s}.exercise:active{background:#f9dfd5}.exercise.flash{background:#e47752;color:#fff;border-color:#d76543;transform:scale(1.045);box-shadow:0 7rpx 14rpx rgba(201,95,62,.2)}.custom{display:flex;gap:12rpx;margin-top:24rpx;padding-top:20rpx;border-top:1rpx solid #eee9e2}.custom-input{flex:1;height:74rpx;background:#fff;border:2rpx solid #e5dfd7;border-radius:18rpx;padding:0 18rpx}.custom-button{width:84rpx;height:74rpx;line-height:70rpx;background:#26354a;color:#fff;border:0;border-radius:18rpx;padding:0}.custom-button::after{border:0}.empty{text-align:center;color:#8b8882;padding:22rpx}
.picker-card{background:#fff;border-color:#e2eaf4;box-shadow:0 10rpx 30rpx rgba(30,65,110,.055)}.heading,.lib-heading{color:#132b4f}.search{background:#f3f6fb;border-color:#dde6f2}.group{background:#edf3fb;color:#526781}.group.on,.custom-button{background:#132b4f}.lib-heading{border-left-color:#2563eb}.exercise{background:#edf3fb;color:#415574}.exercise:active{background:#dceaff}.exercise.flash{background:#2563eb;border-color:#1d4ed8;box-shadow:0 7rpx 14rpx rgba(37,99,235,.2)}
.custom-title{font-size:22rpx;font-weight:850;color:#132b4f;margin-top:24rpx;padding-top:20rpx;border-top:1rpx solid #e5ebf3}.custom{margin-top:12rpx;padding-top:0;border-top:0;gap:9rpx}.custom-input{min-width:0}.custom-group-picker{flex:none;height:74rpx;line-height:74rpx;padding:0 14rpx;background:#edf3fb;border:1rpx solid #d8e3f1;border-radius:17rpx;color:#24476f;font-size:21rpx;font-weight:800}.custom-button{width:92rpx;font-size:21rpx;font-weight:800}
.exercise-wrap{display:flex;align-items:center;background:#edf3fb;border-radius:999rpx;overflow:hidden}.exercise-wrap .exercise{border-radius:999rpx}.exercise-wrap.custom-exercise .exercise{padding-right:10rpx}.exercise-manage{display:flex;align-items:center;padding-right:9rpx}.exercise-manage text{padding:10rpx 7rpx;color:#7b8798;font-size:17rpx}.exercise-manage text:last-child{color:#a06458}.cancel-custom-edit{text-align:center;padding:14rpx 0 0;color:#7b8798;font-size:20rpx}
