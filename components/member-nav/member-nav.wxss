.member-nav{position:fixed;left:0;right:0;bottom:0;z-index:20;background:rgba(255,255,255,.97);border-top:1rpx solid #e6e8ea;padding:12rpx 34rpx calc(12rpx + env(safe-area-inset-bottom));display:flex;justify-content:space-around;box-shadow:0 -8rpx 30rpx rgba(30,75,58,.06)}.member-nav-item{min-width:120rpx;text-align:center;color:#82928c;font-size:21rpx}.nav-mark{font-size:34rpx;line-height:40rpx}.member-nav-item.active{color:#3a454e;font-weight:750}
