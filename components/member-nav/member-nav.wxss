.member-nav-shield{position:fixed;left:0;right:0;bottom:0;height:calc(124rpx + env(safe-area-inset-bottom));z-index:19;background:var(--member-page-bg,#F7F7F2)}
/* 2026-10-23 · Minimalist 浮动导航 */
.member-nav-shield{background:#fbfaf5}.member-nav{border-color:rgba(16,63,59,.07);border-radius:34rpx;box-shadow:0 14rpx 38rpx rgba(16,63,59,.12)}.member-nav-item.active{color:#103f3b}.member-nav-item.active::after{background:#22a77a;width:38rpx}.member-nav-item.active .nav-mark{color:#176e68}
.member-nav{position:fixed;left:22rpx;right:22rpx;bottom:calc(18rpx + env(safe-area-inset-bottom));z-index:20;background:#fff;border:1rpx solid rgba(23,59,87,.06);border-radius:32rpx;padding:12rpx 60rpx;display:flex;justify-content:space-around;box-shadow:0 10rpx 34rpx rgba(23,59,87,.12)}.member-nav-item{position:relative;flex:1;max-width:220rpx;text-align:center;color:#91A09D;font-size:20rpx;line-height:1.25;padding:3rpx 0;transition:transform .14s ease,color .14s ease}.member-nav-item:active{transform:scale(.94)}.nav-mark{font-size:32rpx;line-height:40rpx;font-weight:500}.member-nav-item.active{color:#173B57;font-weight:760}.member-nav-item.active::after{content:"";position:absolute;left:50%;bottom:-7rpx;width:28rpx;height:5rpx;border-radius:999rpx;background:#2DACB5;transform:translateX(-50%)}

/* 2026-10-23 · Minimalist 最终层叠 */
.member-nav-shield{background:#fbfaf5}.member-nav{border-color:rgba(16,63,59,.07);border-radius:34rpx;box-shadow:0 14rpx 38rpx rgba(16,63,59,.12)}.member-nav-item.active{color:#103f3b}.member-nav-item.active::after{background:#22a77a;width:38rpx}.member-nav-item.active .nav-mark{color:#176e68}
