/* ⭐ 三态时段小卡片：**唯一来源**是 styles/slots.wxss（会员端约课时段共用同一份）。
   本组件只提供**教练端配色**（.slots-coach）与容器高度，不重定义任何卡片样式。
   回归护栏：tests/slot-card-single-source.test.js */
@import "../../styles/slots.wxss";
.mask{position:fixed;inset:0;background:rgba(28,34,43,.52);z-index:50;display:flex;align-items:center;justify-content:center;padding:38rpx;box-sizing:border-box;backdrop-filter:blur(6px)}
.modal{width:100%;height:auto;max-height:82vh;box-sizing:border-box;background:#fffdf9;border-radius:32rpx;padding:32rpx;position:relative;overflow-y:auto;box-shadow:0 30rpx 80rpx rgba(20,25,33,.28);border:1rpx solid rgba(255,255,255,.55)}
.title{font-size:36rpx;font-weight:850;color:#26354a;letter-spacing:.5rpx}.close{position:absolute;right:24rpx;top:19rpx;width:58rpx;height:58rpx;border-radius:50%;background:#f1ede7;font-size:39rpx;line-height:52rpx;text-align:center;color:#89857f}
.time-banner{display:flex;justify-content:space-between;align-items:center;margin-top:20rpx;padding:19rpx 20rpx;background:linear-gradient(135deg,#fbe9e1,#f7eee8);border:1rpx solid #f0d4c9;border-radius:19rpx;color:#b45237}.time-label{font-size:21rpx;color:#8f6d61}.time-value{font-size:26rpx;font-weight:850}
.input,.picker{height:80rpx;border:2rpx solid #e7e1d9;border-radius:18rpx;padding:0 20rpx;line-height:80rpx;margin-top:15rpx;font-size:26rpx}.search-input{background:#f5f2ed;padding-left:24rpx}.student-scroll{height:48vh;max-height:620rpx;margin-top:10rpx}.student{display:flex;justify-content:space-between;align-items:center;padding:19rpx 18rpx;margin-top:10rpx;background:#fff;border-radius:19rpx;border:1rpx solid #ece6de;box-shadow:0 5rpx 14rpx rgba(46,41,35,.035)}.student:active{background:#fbefe9}.name{font-size:27rpx;font-weight:800;color:#30343a}.hint{font-size:21rpx;color:#8c8983;margin-top:5rpx}.remain{font-size:21rpx;font-weight:700;color:#b85539;background:#fbe7df;border-radius:999rpx;padding:8rpx 12rpx}
.label{font-size:23rpx;font-weight:700;color:#60636a;margin-top:20rpx}.pkg{border:3rpx solid #e7e1d9;border-radius:21rpx;padding:19rpx;margin-top:12rpx;transition:transform .12s}.pkg>view:first-child{font-weight:800;color:#32363d}.pkg.selected{border-width:5rpx;box-shadow:0 9rpx 22rpx rgba(38,53,74,.12);transform:translateY(-1rpx)}.pkg.disabled{opacity:.42;filter:grayscale(.5)}
.time-row{display:flex;gap:16rpx}.time-picker{flex:1}.editable{border:2rpx solid #e6b8a7}.time-editor{background:#f5f2ed;border-radius:21rpx;padding:2rpx 16rpx 16rpx;margin-top:13rpx}.confirm{background:linear-gradient(135deg,#e47752,#c95f3e);color:#fff;border:0;border-radius:21rpx;margin-top:26rpx;font-size:27rpx;font-weight:800;box-shadow:0 10rpx 24rpx rgba(201,95,62,.2)}.confirm::after{border:0}.back{text-align:center;color:#7f7c76;font-size:23rpx;font-weight:650;padding:20rpx}.empty{text-align:center;padding:60rpx;color:#85827d}
.mask{background:rgba(15,33,61,.55)}.title{color:#132b4f}.time-banner{background:linear-gradient(135deg,#e8f1ff,#f2f7ff);border-color:#cbdcff;color:#1d4ed8}.time-label{color:#5f7596}.remain{color:#1d4ed8;background:#e8f0ff}.student:active{background:#edf4ff}.editable{border-color:#aac5ef}.time-editor{background:#edf3fb}.confirm{background:linear-gradient(135deg,#3b82f6,#1d4ed8);box-shadow:0 10rpx 24rpx rgba(37,99,235,.2)}
.time-editor{padding:22rpx;margin-top:16rpx;background:linear-gradient(160deg,#f7faff,#edf4ff);border:1rpx solid #cdddf3;border-radius:25rpx}.time-editor-head{display:flex;align-items:center;justify-content:space-between}.time-editor-head b{display:block;font-size:27rpx;color:#17345f}.time-editor-head text{display:block;font-size:19rpx;color:#7b8da6;margin-top:4rpx}.time-preview{font-size:32rpx;font-weight:900;color:#1d4ed8;background:#fff;border:1rpx solid #cbdcff;border-radius:16rpx;padding:12rpx 17rpx}.date-choice{height:76rpx;margin-top:18rpx;padding:0 18rpx;display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:14rpx;background:#fff;border:1rpx solid #d5e0ef;border-radius:17rpx;color:#60728b}.date-choice b{text-align:center;color:#17345f;font-size:24rpx}.choice-label{font-size:20rpx;font-weight:800;color:#526780;margin:18rpx 0 9rpx}.hour-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:9rpx}.hour-chip{height:54rpx;display:flex;align-items:center;justify-content:center;background:#fff;border:1rpx solid #d7e1ef;border-radius:13rpx;color:#55667c;font-size:21rpx;font-weight:700}.hour-chip.on{background:#2563eb;border-color:#2563eb;color:#fff;box-shadow:0 6rpx 14rpx rgba(37,99,235,.22)}.minute-tabs{display:grid;grid-template-columns:1fr 1fr;gap:12rpx}.minute-tabs>view{height:66rpx;display:flex;align-items:center;justify-content:center;background:#fff;border:2rpx solid #d5e0ef;border-radius:16rpx;color:#52647b;font-size:23rpx;font-weight:750}.minute-tabs>view.on{background:#173f77;border-color:#173f77;color:#fff;box-shadow:0 7rpx 16rpx rgba(23,63,119,.2)}
.mask{align-items:flex-end;padding:0}.modal{max-height:91vh;border-radius:36rpx 36rpx 0 0;padding:28rpx 30rpx calc(26rpx + env(safe-area-inset-bottom));animation:bookingSheetIn .3s cubic-bezier(.2,.8,.2,1)}@keyframes bookingSheetIn{from{transform:translateY(100%)}to{transform:translateY(0)}}.compact-time{background:#f4f7fc;border-color:#dbe5f2;padding:22rpx}.select-line{display:grid;grid-template-columns:58rpx 1fr 24rpx;height:88rpx;padding:0 17rpx;margin-top:13rpx;box-shadow:0 5rpx 14rpx rgba(29,63,111,.04)}.select-line>view:nth-child(2) text,.select-line>view:nth-child(2) b{display:block;text-align:left}.select-line>view:nth-child(2) text{font-size:19rpx;color:#8391a4}.select-line>view:nth-child(2) b{font-size:25rpx;color:#17345f;margin-top:2rpx}.select-icon{width:48rpx;height:48rpx;border-radius:15rpx;background:#e5efff;color:#2563eb;display:flex;align-items:center;justify-content:center;font-weight:900}.time-icon{background:#e8ecff;color:#4f46e5}.select-arrow{font-size:34rpx;color:#8997aa}.time-tip{text-align:center;color:#7d8da3;font-size:19rpx;padding:17rpx 0 1rpx}.time-editor-head{padding:1rpx 2rpx 6rpx}
.compact-pkg{display:grid;grid-template-columns:54rpx 1fr auto;align-items:center;gap:13rpx;padding:12rpx 15rpx;border-width:2rpx;border-radius:17rpx;margin-top:9rpx}.compact-pkg.selected{border-width:3rpx;transform:none}.pkg-icon{width:50rpx;height:50rpx;border-radius:15rpx;display:flex;align-items:center;justify-content:center;font-size:24rpx}.pkg-copy>view:first-child{font-size:24rpx;font-weight:850;color:#253b59}.pkg-copy .hint{margin-top:1rpx;font-size:18rpx}.pkg-price{font-size:21rpx;font-weight:850;color:#1d4ed8;white-space:nowrap}

/* ── 三态时段卡片在弹层里的容器 ────────────────────────────────
   固定高度 420rpx + 内部滚动 + 打开时自动定位到当前已选时段：
   00:00–23:00 共 47 档，4 列 = 12 行；不定高的话这个弹层会长到要把"确认约课"推出去。 */
.slot-box{height:420rpx;margin-top:6rpx}
.slot-box::-webkit-scrollbar{width:0;height:0;display:none}
.slots-head{display:flex;align-items:flex-start;justify-content:space-between;gap:16rpx;padding:2rpx 2rpx 10rpx}
/* 精确到分钟：默认收起的一行入口（原来那个 time picker 一个字没改，只是藏在这行后面） */
.precise-toggle{text-align:center;color:#7d8da3;font-size:19rpx;padding:16rpx 0 2rpx}
.precise-toggle:active{color:#2563eb}

/* 2026-10-17 · 教练约课弹窗与会员端统一：底部滑出、少阴影、青绿色选择反馈。 */
.mask{background:rgba(12,38,40,.42);backdrop-filter:blur(6px)}
.modal{max-height:88vh;padding:30rpx 34rpx calc(24rpx + env(safe-area-inset-bottom));border:0;border-radius:36rpx 36rpx 0 0;background:#fff;box-shadow:0 -12rpx 38rpx rgba(18,54,53,.12);animation-duration:.24s}
.title{color:#153536;font-size:34rpx}
.close{right:28rpx;top:22rpx;background:#f1f5f3;color:#71827f}
.time-banner{background:#edf7f4;border:1rpx solid #cee5df;color:#176e68}
.time-label{color:#6f8580}
.student{border:0;border-bottom:1rpx solid #e9efed;border-radius:0;box-shadow:none}
.student:active{background:#f0f8f5}
.remain{background:#e8f5f1;color:#176e68}
.compact-pkg{border-color:#dfe9e6!important;border-radius:18rpx;box-shadow:none!important}
.compact-pkg.selected{border-color:#238d80!important;background:#edf8f4!important}
.pkg-copy>view:first-child{color:#173b3a}
.pkg-price{color:#176e68}
.compact-time{background:#f5f8f7;border-color:#dce9e5;box-shadow:none}
.time-editor-head b,.select-line>view:nth-child(2) b{color:#173b3a}
.time-preview{color:#176e68;border-color:#cce3dd;box-shadow:none}
.select-icon{background:#e3f3ee;color:#176e68}
.time-icon{background:#e8f1ef;color:#176e68}
.hour-chip.on,.minute-tabs>view.on{background:#176e68;border-color:#176e68;box-shadow:none}
.confirm{height:88rpx;line-height:88rpx;background:#133f46;border-radius:22rpx;box-shadow:none}
.precise-toggle:active{color:#176e68}

/* 2026-10-23 · 点击课表时间格后的预约弹层，与样板完全共用色板。 */
.mask{background:rgba(12,38,40,.46)}.modal{background:#fbfaf5;border-radius:36rpx 36rpx 0 0}.title{color:#102a2b}.close{background:#eafaf4;color:#176e68}.time-banner,.compact-time{background:linear-gradient(145deg,#edf3ff,#fff);border-color:#dce7fa}.time-banner{color:#4c76df}.time-label{color:#7183a1}.student{background:#fff}.student:active{background:#eafaf4}.remain{background:#eafaf4;color:#176e68}.compact-pkg.selected{border-color:#22a77a!important;background:#eafaf4!important}.pkg-price{color:#176e68}.select-icon,.time-icon{background:#dff7ee;color:#176e68}.hour-chip.on,.minute-tabs>view.on,.confirm{background:#103f3b;border-color:#103f3b;color:#fff}.time-preview{color:#176e68}.slot-cell:not(.booked):not(.past){background:linear-gradient(145deg,#fff,#eafaf4)}
