.diagnostic-page{padding:24rpx;background:var(--bg);min-height:100vh}.diagnostic-page .card{margin-bottom:20rpx;padding:24rpx}.diagnostic-page .title{font-size:30rpx;font-weight:700;color:var(--navy)}.diagnostic-page .hint{display:block;margin-top:12rpx;color:var(--muted);font-size:23rpx;line-height:1.6}.course-list{max-height:500rpx;margin-top:14rpx}.course-row{padding:18rpx 6rpx;border-bottom:1rpx solid var(--line);font-size:24rpx}.plain{display:block;margin-top:16rpx;line-height:1.6;color:var(--text)}.detail{display:block;margin-top:16rpx;white-space:pre-wrap;word-break:break-all;font-size:20rpx;line-height:1.5;color:var(--muted)}
