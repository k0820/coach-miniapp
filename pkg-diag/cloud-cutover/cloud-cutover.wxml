<view class="page">
  <view class="card">
    <view class="title">真实云端切换</view>
    <view class="hint">当前状态：{{status}}</view>
    <view wx:if="{{status === 'cutover-pending' || status === 'activating'}}" class="warning">云端激活结果正在确认，或切换尚未完成。当前已暂停业务修改，请继续完成云端切换。</view>
    <button class="secondary" bindtap="check" loading="{{busy}}" disabled="{{busy || status === 'cutover-pending' || status === 'activating' || status === 'cloud-primary'}}">最终切换检查</button>
    <button class="primary" bindtap="activate" loading="{{busy}}" disabled="{{busy || (!ready && status !== 'cutover-pending' && status !== 'activating') || status === 'cloud-primary'}}">{{status === 'cutover-pending' || status === 'activating' ? '继续完成云端切换' : '激活并切换到云端'}}</button>
    <button wx:if="{{status === 'cloud-primary'}}" class="secondary" bindtap="locateLegacyBooking" loading="{{busy}}" disabled="{{busy}}">定位 Legacy 历史课程</button>
  </view>
  <view class="card"><text selectable="true" class="result">{{result}}</text></view>
</view>
