.page{padding:28rpx;background:#f3f6fb;min-height:100vh;box-sizing:border-box}.card{background:#fff;border-radius:24rpx;padding:28rpx;margin-bottom:24rpx;box-shadow:0 8rpx 24rpx rgba(19,43,79,.08)}.title{font-size:34rpx;font-weight:700;color:#132b4f}.hint{margin:14rpx 0 22rpx;color:#6b7280;font-size:26rpx}.warning{margin:18rpx 0;padding:20rpx;border-radius:16rpx;background:#fff7ed;color:#9a3412;font-size:26rpx;line-height:1.6}.primary{margin-top:18rpx;background:#132b4f;color:#fff}.secondary{margin-top:18rpx;color:#132b4f;background:#fff;border:1rpx solid #cbd5e1}.result{font-family:monospace;font-size:23rpx;white-space:pre-wrap;word-break:break-all;color:#334155}
