.page{padding:28rpx;background:#f3f6fb;min-height:100vh;box-sizing:border-box}.card{background:#fff;border-radius:24rpx;padding:28rpx;margin-bottom:24rpx;box-shadow:0 8rpx 24rpx rgba(19,43,79,.08)}.title{font-size:34rpx;font-weight:700;color:#132b4f}.hint,.progress{margin:14rpx 0 22rpx;color:#6b7280;font-size:26rpx;line-height:1.6}button{margin-top:18rpx}.primary{background:#2563eb;color:#fff}.danger{color:#c2412d;background:#fff;border:1rpx solid #fecaca}.result{font-family:monospace;font-size:23rpx;white-space:pre-wrap;word-break:break-all;color:#334155}
